// XAU_AI_PRO v1.2.9 - VersionManager v2.0 (ETAPA 10)
// Versao padronizada, build date, registro do estado dos modulos.
// SEM auto-update: atualizacao somente controlada/manual (seguranca).
#ifndef VERSION_MANAGER_MQH
#define VERSION_MANAGER_MQH

// Versao do PRODUTO. Precisa acompanhar o arquivo `VERSION` na raiz, que e a
// fonte unica propagada por `scripts/sync_version.py`.
//
// Estava em "1.2.0" enquanto o produto e 1.2.4: o `[VERSION]` que o EA
// escreve no log, e que a tela mostra, dizia uma versao que nao existe mais.
// Este modulo nao esta na lista de manifestos do `sync_version.py`, entao a
// divergencia nao era detectada por `--check`.
#define EA_VERSION_STRING "1.2.191"

struct VersionInfo
{
   string version;
   string build_date;
   string author;
   string changes;
   bool   stable;
};

class CVersionManager
{
private:
   static VersionInfo m_current;
   static bool     m_initialized;
   static bool     m_auto_update;
   static int      m_module_count;
   static string   m_modules[32];
   static string   m_module_state[32];
   static void RegisterModule(const string name, const string state);
public:
   static void Init();
   static void RegisterModules();
   static void CheckForUpdates();            // sem auto-update: apenas informativo
   static bool DownloadUpdate(const string version);   // bloqueado (seguranca)
   static void SetAutoUpdate(bool enable);   // forca false
   static string GetCurrentVersion();
   static VersionInfo GetVersionInfo();
   static string GetModulesSummary();
   static string GetStatus();
   static void LogStatus();
};

VersionInfo CVersionManager::m_current;
bool CVersionManager::m_initialized = false;
bool CVersionManager::m_auto_update = false;
int  CVersionManager::m_module_count = 0;
string CVersionManager::m_modules[32];
string CVersionManager::m_module_state[32];

void CVersionManager::Init()
{
   if(m_initialized) return;
   m_initialized = true;

   m_current.version    = EA_VERSION_STRING;
   m_current.build_date = TimeToString(TimeCurrent(), TIME_DATE);
   m_current.author     = "XAU_AI_PRO Team";
   m_current.changes    = "v1.2.191 (09/11/2026) - P1.3514: a linha que recusava a entrada dizia o motivo ERRADO. MEDIDO por leitura do codigo em 09/11/2026: o caminho de lote em uso (MaxRiskPerTradeUsd=8.00) e CalculateDynamicLot -> CalculateLotByRiskAuto -> CalculateLotByRiskUSD -> RiscoEmDinheiroDaOrdem, e quando a ficha do simbolo nao tem tick_value/tick_size/point o CalculateLotByRiskUSD recusa com a linha RISK: valor do ponto indisponivel (simbolo, tick_value=0.00000, tick_size=0.00000, point=...) e devolve 0.0; a linha seguinte, escrita por CalculateDynamicLot em Core/ExecutionEngine.mqh, dizia lote de referencia invalido (risco/escala) e atribuia o bloqueio ao RISCO. Medido no servidor actual: USDCLP e USDRUB tem tick_value=0.00000000, tick_size=0.00000000 e margin_initial=0.00 na ficha, portanto a frase errada sairia exactamente nos dois simbolos que o forward ainda nao visitou. Correccao: nasce RiskLotBlockReason(simbolo) em Core/RiskEngine.mqh, que mede a mesma ficha (tick_value, tick_size, point, volume_min) e devolve o motivo MEDIDO - ficha sem dados de tick, ficha sem volume_min, ou risco/escala quando a ficha esta intacta; CalculateDynamicLot passa a imprimir esse motivo em vez do texto fixo. Nenhum limite, lote, alvo, stop, spread, preco, regra de entrada ou de saida, ou parametro de risco foi alterado: as guardas de divisao por zero (Config.mqh:1046, Config.mqh:1102 e RiskEngine.mqh:114) ficam exactamente iguais e continuam a recusar antes de dividir; muda apenas o texto que explica a recusa. Na mesma versao o default compilado do teto diario passa a acompanhar a DECISAO DO DONO de 09/11/2026 15:01 (opcao A): MaxDailyLossUsd 60.0 -> 600.0 e MaxDailyLossPercent 10.0 -> 3.0. O teto efetivo medido e 379,67 (3,00% do saldo 12 655,63) e NAO 600, porque OrcamentoDiarioPerda aplica MIN(USD, saldo*%). A mudanca APERTA e nao afrouxa: um reattach que omita a input deixa de poder cair num default de 10% (1 265,56) e passa a cair no valor aprovado. Nenhum outro parametro de risco foi tocado; MaxDrawdownPercent (50.0), RiskPercent (1.0) e EnableStoplessEntry continuam com o default anterior e por isso o reattach dos 15 graficos TEM de levar a lista completa de inputs, so com os campos alvo alterados. " "v1.2.190 (09/11/2026) - P1.3507: o teto de risco por operacao media a distancia ERRADA quando a entrada nao leva stop, e por isso nunca disparava. MEDIDO em 09/11/2026 no journal dos 15 graficos: com EnableStoplessEntry=true a ordem saia sem SL e o cap de MaxRiskPerTradeUsd=8.00 comparava o risco com NoiseDistancePointsForRisk(), que e a distancia de ARMADURA (~0,8 ATR) e nao a distancia de EMERGENCIA (1,5 x 1R) que o vigia CheckStoplessEmergency usa para fechar a posicao. Resultado: 0,06 lote XAUUSD sem stop, ~2000 pontos ate 4076,21 = -119,40 USD, contra um teto de 8,00 USD por operacao e 60,00 USD por dia, e a linha MIN_LOT_EXCEEDS_RISK_CAP nunca saiu. Correcao: nascem StoplessRiskDistancePoints() e RiskDistancePointsForCap() em Core/ExecutionEngine.mqh; o 1R do cap passa a ser a distancia de emergencia quando EnableStoplessEntry esta ligado, o SL real quando a entrada leva stop, e a distancia de armadura como ultimo recurso. A formula e a mesma de StoplessEmergencyDistance() (PositionManager.mqh) para que o risco MEDIDO e o risco FECHADO sejam o mesmo numero, e a conta e refeita no proprio ficheiro porque ExecutionEngine.mqh e incluido antes de PositionManager.mqh. Os dois sitios que usavam NoiseDistancePointsForRisk (CalculateDynamicLot e o teto com o lote final) passam a usar a mesma funcao. Nenhum limite, lote, alvo, stop, spread, preco, regra de entrada ou de saida, ou parametro de risco foi alterado: com EnableStoplessEntry=false, que e a configuracao dos 15 graficos, o valor devolvido e EXACTAMENTE o mesmo de antes (slRefPoints se maior que 0, distancia de armadura se nao), portanto o patch e INERTE na configuracao em vigor e so fecha o buraco se a entrada sem stop for religada. Na mesma versao o XAU_AI_PRO.mqproj deixa de estar em 1.386 / v1.2.186 e passa a 1.390 / v1.2.190, alinhado com #property version, EA_VERSION_STRING e EV_VERSION_STRING. " "v1.2.189 (09/11/2026) - P1.3499 / P1.3500: o limite de perda diaria deixa de medir o SALDO da conta e passa a medir o resultado do EA por magic. MEDIDO em 09/11: o EA perdeu 119,40 USD as 02:15 e ficou bloqueado, mas as 08:54 um lucro MANUAL de +117,20 subiu o saldo, `m_daily_profit` passou a +13,76 e o EA ficou re-armado no mesmo dia depois de ja ter estourado 199% do orcamento de 60,00. CheckDailyLoss e CheckDailyDrawdown passam a somar os deals de HOJE com MagicNumber (profit + swap + comissao); operacoes manuais (magic 0) deixam de abrir ou fechar o gate. Em paralelo, os 15 graficos passam a correr com SymbolsFromMarketWatch=false (universo = os 15 simbolos aprovados, sem herdar AMD/MSFT/INTC/NVDA/GOLD do Market Watch) e EnableStoplessEntry=false (o SL vai na ordem; a entrada sem stop deixou passar 2000 pontos sem corte e o teto de 1,5R nao fechou). Nenhum limite, lote, alvo, spread, preco ou regra de entrada foi alterado: o gate muda a FONTE do numero (magic, nao saldo) e duas entradas de configuracao fisica passam a proteger a ordem. " "v1.2.188 (08/11/2026) - P1.3479 / P1.2336 / P1.139: tres defeitos de OBSERVABILIDADE, nenhum de estrategia e nenhum que toque num limite, lote, alvo, stop, spread, preco, regra de entrada ou de saida, ou parametro de risco. (1) P1.3479 - a tabela de throttle do Strategy Tester (Monitoring/AccountLogGate.mqh, TESTER_GATE_MAX_TAGS) tinha 128 vagas e o universo do EA precisa de mais: as 7 tags do ATR levam o simbolo no nome, logo 7 x 15 simbolos = 105 vagas, e com as restantes familias (~20 por simbolo) o universo passa de 400 chaves. MEDIDO nos ficheiros de gate de Common/Files/XAU_AI_PRO: o sufixo __DATETIME__ e CONSTANTE por build (loggate_atr_no_read_XAUUSD_1793915847.bin repete-se em todas as chamadas daquele build), portanto a tag com marcador NAO cresce por segundo - o que faltava era CAPACIDADE, e a correcao anteriormente proposta de remover o marcador teria libertado ZERO vagas. Ao encher, o ramo antigo nao registava a tag e devolvia true, e desse instante em diante toda a tag nova falava sem throttle: foi assim que o [TREND] LEITURA SUSPEITA saiu 278 536 vezes (USDSEK 73 464) com uma janela de 3600 s, 85x acima do maximo teorico. A tabela passa a 512 vagas e, se mesmo assim encher, LIBERTA a chave usada ha mais tempo em vez de desligar o portao - o mesmo padrao do P1.114 no DiagGate, ja provado - com 1 linha [DIAG] LOGGATE TESTER tabela cheia por hora como prova de saturacao. O marcador __DATETIME__ foi mantido: e o P1.121 (um build novo tem de falar mesmo que um build antigo ja tenha gasto a hora) e nao consome vaga a mais. (2) P1.2336 - o [SCANNER] RESUMO publicava trades=0 em 7429 janelas enquanto o dia tinha 34 deals reais, porque os contadores da janela eram zerados em TODOS os ciclos (~60 s) e a linha so saia quando o portao por conta a deixava passar (SCAN_SILENT_SEC = 15 min): publicava-se o ultimo ciclo e nao o intervalo anunciado na propria linha. Passam a ser zerados apenas quando a linha realmente sai; o relogio do ciclo (g_scanJanela) continua a avancar em todos os ciclos, porque e ele que marca os 60 s entre varreduras. (3) P1.139 - o passo 1 do AllowTradeEx (VALIDACAO) era o unico dos gates que devolvia false sem escrever a causa por inteiro: MEDIDO 1576 sinais num dia, 1576 vetados e nenhuma linha com a razao. Passa a imprimir DECISION BLOCKED | VALIDATION com o motivo, no maximo 1x/hora por CONTA e por simbolo+motivo (motivo novo sai na hora), com a tag saneada por ValidationGateTag e prefixo proprio para nao gastar a vez da linha [VALIDATION] BLOCK escrita pelo ValidateTrade. " +
      "v1.2.185 (07/11/2026) - Q-079 = B (decisao do DONO): o portao de tendencia mantem bid vs EMA200 H1 mas com FOLGA DE 1 ATR. O sinal exige EMA50>EMA200 + RSI<45 (pullback fundo) e o portao lia contramao quando o bid furava a EMA200 por pouco - o EA vetava o sinal que a regra procura (MEDIDO 05/11: 1576 sinais, 1576 em AllowTradeEx, 0 passaram; 58,5% dos vetos eram TREND). Acima de 1 ATR continua contramao; sem leitura de EMA/ATR o rigor antigo fica. Nenhum lote, SL, TP ou limite de risco muda." +
      "v1.2.184 (07/11/2026) - P1.138 / GATE_REAL G3: o MarketScore deixa de saturar em 100.00 e o piso MinMarketScore volta a filtrar. MEDIDO antes de escrever uma linha: CalculateMarketScore comecava com base 50.0 e somava EMA +20, RSI +15, ADX +15, KCI direccional +10, KCI volatilidade +5 e IA +0.50*confianca, num maximo de 165 que era cortado em 100. As tres primeiras parcelas nao sao bonus, sao condicoes de EXISTIR sinal (EMA alinhada, RSI entre 30 e 70, ADX >= MinimumADX=18.0), portanto a soma chegava a 50+20+15+15 = 100.00 antes da IA e do KCI, e o corte em 100 nao era o que limitava. Resultado medido pelo DELTA em 06/11: 162 de 162 amostras [SCORE] com TOTAL=100.00 e o piso MinMarketScore=65.0 aprovava tudo o que chegasse - o filtro estava morto e o score nao distinguia sinal bom de sinal fraco. Correcao: sai a base arbitraria de 50.0 e o total passa a ser a FRACAO dos pontos possiveis em escala 0..100, com maxScorePoints=115.0 (20+15+15+10+5+50), sem alterar o peso relativo de nenhuma parcela. Consequencia aritmetica, escrita antes de medir: um sinal com EMA+RSI+ADX e sem IA vale agora 43.48 e e recusado pelo piso de 65.0; as mesmas tres parcelas com IA a 72.4 por cento valem 74.9 e passam; um sinal fraco (ADX abaixo do minimo e RSI fora da banda) cai para 30-40 e e recusado. O journal passa a imprimir PTS (pontos brutos) ao lado de TOTAL (escala normalizada) para que a mudanca de escala fique visivel em cada linha [SCORE]. Nenhum limite de risco, lote, alvo, stop, spread, preco, regra de entrada ou de saida, ou parametro de risco foi alterado: muda a escala em que um piso que ja existia e comparado, e o piso continua em 65.0. GATE_REAL continua 1 verde de 11 e este patch nao escreve 10/10. " +
      "v1.2.183 (07/11/2026) - P1.137: a guarda de identidade do ATR escolhia o lado ERRADO e, ao insistir, matava o ATR do simbolo ate ao fim do build. MEDIDO no reload da v1.2.182, com os 15 graficos, entre as 00:07 e as 00:15 de 07/11: '[ATR] IDENTIDADE ERRADA | USDCLP | doHandle=4.315000 | daSerie=203.576255 | falhas=1 | usaHandleAgora=SIM' seguida de '[ATR] LEITURA SUSPEITA | USDCLP | ATR=203.576300 | preco=971.0500 | ATR%=20.96 | handle=10 | barsCalc=10207 | barrasSerie=10207 | devolvido=0.0', e '[ATR] IDENTIDADE ERRADA | USDCOP | doHandle=14.780000 | daSerie=73950.936209 | falhas=1' seguida de '[ATR] LEITURA SUSPEITA | USDCOP | ATR=73950.940000 | preco=3251.56 | ATR%=2274.32'. Os dois valores do handle sao plausiveis (0.44 e 0.45 por cento do preco); os dois valores da serie sao fisicamente impossiveis (20.96 e 2274.32 por cento) e seriam apanhados pela guarda de plausibilidade do P1.112. O codigo antigo adoptava SEMPRE o valor da serie e contava a falha, portanto apos ATR_IDENTITY_MAX_FAIL=2 o simbolo caia em ATRRatesOnly() e a plausibilidade passava a devolver 0.0 para o resto do build: o ATR ficava permanentemente sem leitura exactamente nos simbolos onde a guarda disparava. Correcao: quando o valor da serie e impossivel pela mesma regra do P1.112 (ATR_MAX_PLAUSIBLE_PCT=5.0 sobre o bid), o valor da serie e DESCARTADO, o valor do handle e MANTIDO, ATRIdentityClear limpa a falha (nao conta) e sai uma linha por simbolo por build a dizer que a serie foi descartada, com os dois valores, a percentagem e o limite; quando o valor da serie e plausivel nada muda e o comportamento antigo fica intacto (adopta a serie e conta a falha). Nenhum limite de risco, lote, alvo, stop, spread, preco, regra de entrada ou de saida, ou parametro de risco foi alterado: muda QUEM manda quando os dois lados discordam e quando uma falha conta para o rates-only. Compilado 0 errors / 0 warnings. " +
                          "v1.2.182 (07/11/2026) - D-068, Q-071 e Q-025 no mesmo compile: a IA deixa de bloquear por chave inexistente, o limite de drawdown passa a 50 por cento na input e o kill switch automatico ganha gatilho. MEDIDO antes de escrever uma linha, em 06/11/2026 23:57: o gateway publica 1122 bytes para XAUUSD com as chaves ok, available, signal, confidence, prob_buy, prob_sell, prob_neutral, price, atr, edge, accuracy, model e feature_hash, e NAO publica buy, sell nem score; o parser lia exactamente as tres que nao existem, a conversao de cadeia vazia devolve 0.0, AI_Score ficava 0.0 e AIEngine.mqh:289 com BlockZeroAIScore=true (AIEngine.mqh:568) bloqueava TODA a entrada com a IA a responder - a IA presente era lida como ausente. Correcao no AIConnector, sem tocar no ramo available=false nem no legado prediction_*.json: AI_BuyProbability e AI_SellProbability passam a vir de prob_buy e prob_sell convertidos de 0..1 para 0..100, a escala do log BUY/SELL% e do AIEngine.mqh:139, e AI_Score passa a vir de confidence em 0..100, a escala de MinAIConfidence; quando as probabilidades nao vem, a direcao do signal decide a favorita para nao ficar 0.0 contra 0.0 em AIEngine.mqh:301-304. Q-071 do DONO: MaxDrawdownPercent de 15.0 para 50.0, com o custo escrito na propria input, o fecho de emergencia da conta passa de 1.895,45 USD para 6.318,16 USD e a escada do RiskEngine de 10,05 e 4,95 por cento para 33,5 e 16,5 por cento. Q-025: CKillSwitch::ArmarAutomatico estava implementado e tinha ZERO chamadores, passa a ser accionado no aviso DRAWDOWN ALTO de CheckEquityProtection, e a partir dai as entradas ficam bloqueadas ate reiniciar o EA e as posicoes do magic passam a ser fechadas por Verificar com fechar a true no OnTick e no OnTimer. Nenhum lote, stop, alvo, spread, preco, regra de entrada ou de saida foi alterado: as tres mudancas so podem travar ou reduzir actividade, nunca abrir mais exposicao. GATE_REAL continua 1 verde de 11 e este patch nao escreve 10/10. " +
                          "v1.2.181 (07/11/2026) - F2.2b: o teto de exposicao total passa a medir a MARGEM DA CONTA e nao a soma das posicoes do magic. As duas objecoes levantadas no canal contra a v1.2.180 eram as duas verdadeiras e ficam fechadas na FONTE, nao com um filtro a mais. OBJECAO 1, do CMD no ponto (b): o somatorio por posicao filtrava por MagicNumber, portanto com os 13 graficos no magic 2026001 o teto era da conta por ACIDENTE, e no dia em que o F2.8 der magic unico por grafico o mesmo limite fragmentava-se em 13 tetos independentes de 20 por cento do capital e deixava de existir na pratica. OBJECAO 2, do DELTA no ponto (3b): o somatorio por posicao chamava OrderCalcMargin por simbolo e devolvia -1 se UM simbolo nao fosse calculavel, pelo que um exotico sem margem disponivel recusava a CONTA inteira - fail-closed defensavel, mas um bloqueio da conta inteira causado por um simbolo. CORRECAO: MargemUsadaEA deixa de somar posicoes e passa a ler ACCOUNT_MARGIN, o valor que o servidor calcula e publica para a conta, que por definicao nao tem magic, nao tem laco e nao tem simbolo que possa falhar. MargemSomadaPosicoes fica no codigo SO como instrumento de medida e e publicado na propria linha de bloqueio, para que a divergencia entre o que o servidor diz que a conta usa e o que as posicoes deste magic justificam fique VISIVEL em vez de ficar suposta. EnableExposureCap passa a true por omissao, e a razao e a troca de fonte e nao uma mudanca de apetite de risco: com a soma por posicao o fail-closed podia recusar entradas legitimas por causa de um simbolo, e com ACCOUNT_MARGIN a guarda compara dois numeros que o servidor publica. O RISCO ABERTO SOMADO, medido de entrada ate ao stop, continua a ser limitado pelo envelope que JA existia - MaxTotalRiskPercent, MaxTotalRiskOpenUsd, RiscoAbertoUSD e a recusa RISK_ENVELOPE_FULL - e esse envelope NAO foi alterado por este patch e continua a filtrar por MagicNumber: corrigir esse filtro exige decisao do CMD, foi pedido por escrito e nao foi tomado por mim. Nenhum limite de risco, lote, alvo, stop, spread, preco, regra de entrada ou de saida foi alterado: a guarda e ADITIVA e so pode recusar entradas, nunca abrir. Advertencia que fica escrita: isto mede MARGEM e nao risco de perda. Corrigidos tambem dois carimbos que datavam eventos no FUTURO, apontados pelo DELTA as 21:31: o comentario deste F2.2 dizia 21:35 com mtime 21:28:14 e citava a Q-065 respondida as 21:19 quando a resposta gravada e das 21:27, e ambos passam a 21:28 e 21:27. " +
                          "v1.2.180 (07/11/2026) - F2.2: teto de EXPOSICAO TOTAL da conta, que nao existia. MEDIDO antes de escrever codigo, em toda a arvore: existia `MaxOpenPositions=50` como teto de CONTAGEM (Core/PositionManager.mqh, `CountPositions()>=MaxOpenPositions`) e existia a guarda de correlacao (`EnableCurrencyExposureGuard`, `MaxCorrelatedTrades=3`, `MaxCorrelatedRiskPercent=3.0`), mas nenhuma input, funcao ou linha de journal media quanto capital estava empenhado no conjunto das posicoes do EA. Com 50 vagas e RiskPercent=1.0, o pior caso de 50 stops seguidos e 50% do capital perdido sem que nada o impedisse, porque o teto de contagem ve o NUMERO de posicoes e nao o TAMANHO delas. Correcao: nasce `MargemUsadaEA()`, que soma a margem exigida por todas as posicoes com o MagicNumber do EA (filtro por magic e nunca por simbolo, porque o teto e da CONTA) via `OrderCalcMargin` sobre o volume e o preco corrente de cada posicao, e nasce `ExposicaoDentroDoTeto()`, que compara essa soma com `MaxExposurePercent`% do equity; a chamada entra dentro de `CanOpenPosition` a seguir a guarda manual e ANTES do teto de contagem, portanto o teto de contagem continua a existir e a nova guarda so pode recusar. Quando alguma leitura falha - equity ilegivel, simbolo vazio, volume zero, `OrderCalcMargin` a devolver false - o resultado e RECUSAR (fail-closed), porque NAO CONSEGUI MEDIR nunca pode ser lido como NAO HA EXPOSICAO. O valor em vigor e 20.0, dentro da banda 10%..50% autorizada pelo dono em 06/11/2026 21:19 (Q-065); a escolha esta justificada no cabecalho das inputs, e o log diz porque recusou, com margem em uso, teto, percentagem e equity, no maximo uma vez por minuto. `EnableExposureCap=false` ou `MaxExposurePercent<=0` desligam a guarda e nesse caso nada muda. Nenhum limite de risco, lote, alvo, stop, spread, preco, regra de entrada ou de saida, ou parametro de risco existente foi alterado: a guarda e ADITIVA e so pode recusar entradas, nunca abrir. Advertencia que fica escrita: isto mede MARGEM e nao risco de perda - complementa o SL, o MaxRiskPerTradeUsd e a guarda de correlacao, e nao os substitui. "
                          "v1.2.179 (07/11/2026) - F2.9b: o portao de cotacao velha existia mas era INVISIVEL exactamente quando o feed morre. MEDIDO antes de escrever uma linha, com instrumento separado (Scripts/Temp/XAI_MedirCotacao.mq5) a chamar o MESMO Core/StalenessGuard.mqh de producao, corrido no XAUUSD H1 com o servidor em 2026.11.07 01:33:08 (sabado, mercado fechado): operaria=0, bloquearia=21, sem_leitura=0, limite=120s, com idades de 5590 s (INTC) a 30796 s (USDRUB), XAUUSD=9189 s e GOLD=7615 s. O veredicto sai certo e o fail-closed nao produz um unico falso fresca. Mas o journal do EA, no mesmo intervalo, tinha ZERO linhas [TRADE BLOCK] COTACAO VELHA com 21 de 21 simbolos velhos: o guarda so existia no OnTick, e sem tick o OnTick nao corre, portanto o portao nunca era avaliado precisamente quando o feed morre e o operador perde a unica prova de que o EA sabe que esta cego. Correcao, imitando o F2.1 que ja vive nos dois sitios: o bloqueio continua no OnTick, que e o que impede agir, e passa a haver deteccao de TRANSICAO no OnTimer, que corre a cada 30 s mesmo sem tick - publica [TRADE BLOCK] COTACAO VELHA (timer) uma vez quando o preco congela, um lembrete de hora a hora enquanto continuar congelado e [TRADE BLOCK] COTACAO VOLTOU (timer) quando o feed regressa, sem repetir a cada 30 s. Na mesma versao corrigem-se duas divergencias que a medicao expos: (1) o EA tinha DUAS fontes de verdade para o limite - as inputs EnableStaleDataGuard=true e MaxSymbolTickAgeSec=900 contra o XAI_STALE_MAX_SEC=120 fixo do guarda, ou seja o codigo impunha 120 s enquanto a interface dizia 900 s; o OnInit passa a chamar CStalenessGuard::Configurar(EnableStaleDataGuard, MaxSymbolTickAgeSec) e o 120 s fica apenas como valor de recurso para instrumentos de medicao que nao configurem nada, com o resultado a ser uma so resposta; (2) Core/MarketScanner.mqh SymbolDataFresh() media a idade do tick com TimeCurrent(), que CONGELA sem ticks, contra MqlTick.time, que e tempo do servidor, e passa a TimeTradeServer() com TimeCurrent() so como recurso final, o mesmo principio do P1.24/D-029. Corrigida tambem a deriva HG-01: #property version estava em 1.377 com EA_VERSION_STRING em 1.2.178, e passa a 1.379, coerente com a formula minor*100+patch. Nenhum limite de risco, lote, alvo, stop, spread, preco, regra de entrada ou de saida, ou parametro de risco foi alterado: o EA decide sobre o MESMO mercado, so deixa de decidir sobre um mercado que ja nao existe, e passa a dizer que o fez. " "v1.2.178 (06/11/2026) - F2.9: cotacao velha deixa de operar. MEDIDO no codigo antes de escrever uma linha: o portao de permissoes (Core/TradeGate.mqh) le cinco bits, entre eles TERMINAL_CONNECTED, e NAO existia uma unica verificacao de idade da cotacao em toda a arvore do EA (SymbolInfoTick aparece tres vezes, todas para LER preco, nenhuma para decidir se o preco e de AGORA). Estar ligado ao servidor nao e o mesmo que estar a receber precos: um feed congelado, um simbolo suspenso ou uma sessao que fechou deixam o bit a 1 e a ultima cotacao parada, e o EA decide sobre um mercado que ja nao existe. Novo Core/StalenessGuard.mqh responde a uma pergunta com uma fonte de verdade - a hora do ultimo tick do proprio simbolo - comparando MqlTick.time com TimeTradeServer() (mesma escala do servidor) e usando TimeCurrent() apenas como fallback, porque num terminal sem ticks TimeCurrent congela e um relogio parado a medir outro relogio parado daria sempre idade zero. Limite XAI_STALE_MAX_SEC=120 s. Fail-closed: SymbolInfoTick a falhar ou time<=0 conta como cotacao velha. O bloqueio entra em OnTick depois do portao de permissoes e antes do AutoTrade, imprime [TRADE BLOCK] COTACAO VELHA com a idade medida e o limite, no maximo 1x/300 s, e nao abre, nao fecha e nao altera nada. Nenhum parametro de risco, lote, alvo, stop, spread ou regra de entrada foi tocado: decide apenas se o EA age com o preco que tem. " "v1.2.177 (06/11/2026) - F2.1, fecho do teste: o kill switch da v1.2.176 foi publicado nos 13 graficos (MEDIDO: 13 linhas [START] XAU_AI_PRO v1.2.176 as 20:09:51 e '[KILL SWITCH] estado no arranque | LIVRE'), mas o proprio teste exigido pelo PLANO_10_10 F2.1 revelou uma lacuna de OBSERVABILIDADE que impedia fecha-lo. O ficheiro publicava o estado no arranque e repetia a linha ARMADO a cada 300 s, e nao publicava NADA quando o operador APAGAVA o ficheiro. Consequencia pratica: quem desarmava o interruptor nao tinha como confirmar no journal que o pedido tinha sido lido, e o silencio ficava ambiguo entre 'rearmei' e 'o EA nao viu' - que e o pior defeito possivel num interruptor de emergencia, porque ensina o operador a confiar no silencio. Agora SondarFicheiro() le o disco e PublicarTransicao() publica a transicao LIVRE <-> ARMADO uma vez e sem throttle (transicao e rara; a repeticao periodica continua a cargo do Verificar), e o aviso periodico espera o seu intervalo depois da transicao para nao publicar a mesma informacao duas vezes. A primeira observacao nao imprime de proposito, porque coincide com a linha de arranque do OnInit. A via automatica ArmarAutomatico passa a marcar o estado como ARMADO, por coerencia com o que publica. O ficheiro-sinal, o fail-safe para FECHAR, a precedencia sobre o portao de permissoes e a presenca no OnTick e no OnTimer ficam como estavam. Nenhum limite, lote, alvo, stop, spread, preco, regra de entrada ou de saida, ou parametro de risco foi alterado: e instrumentacao do mesmo interruptor, que so pode REDUZIR actividade. " +
                          "v1.2.176 (06/11/2026) - F2.1: o EA nao tinha NENHUM interruptor accionavel por uma pessoa, e o GATE F2 e bloqueante para conta real. MEDIDO em 06/11/2026: busca por KillSwitch, Halt, Freeze, Panic e EmergencyStop em toda a arvore do EA devolvia ZERO ocorrencias, enquanto o PLANO_10_10 F2.1 exige kill switch manual e automatico com 1 clique ou 1 palavra para fechar tudo, testado. Os gates existentes nao substituem este interruptor e nenhum deles responde a uma ordem humana: CTradeGate le permissoes externas, AutoTrade e um input que obriga a reconfigurar o EA no grafico, e CircuitBreaker, SafetyManager e EquityProtection reagem a CONDICOES (falhas, perda diaria, drawdown). Nasce Core/KillSwitch.mqh com duas vias declaradas e separadas: (1) MANUAL e PERSISTENTE pelo ficheiro MQL5 files XAU_AI_PRO KILL_SWITCH.flag - qualquer conteudo bloqueia ENTRADAS e mantem as posicoes, e conteudo com FECHAR ou CLOSE bloqueia entradas e FECHA todas as posicoes do magic do EA; apagar o ficheiro rearma, e o estado sobrevive ao reinicio do EA, que e o que se quer num interruptor de emergencia; a leitura e fail-safe para o lado seguro (ficheiro existe mas nao se consegue ler implica assumir FECHAR); (2) AUTOMATICO em memoria por CKillSwitch ArmarAutomatico, que fica armado ate reiniciar e NAO escreve ficheiro de proposito, porque um lockout persistente escrito por automatismo com um bug deixaria o sistema parado sem ninguem perceber por que. O interruptor e avaliado ANTES do portao de permissoes, de proposito: quem manda parar quer ver a paragem como PRIMEIRA causa no journal e nao uma linha TRADE BLOCK que sugere que o problema e do terminal, e e o que o torna observavel enquanto o P0 mantem MQL_TRADE_ALLOWED=0 nos 13 graficos. Corre no OnTick e tambem no OnTimer, porque MEDIDO em 06/11/2026 23:59:58 hora do servidor o mercado fechou a sexta-feira e o journal do EA parou as 18:58:59 locais: sem tick nao ha OnTick, e um interruptor que so vivesse no OnTick estaria MORTO exactamente quando o operador tem tempo para o accionar (cobre tambem o F2.9, deteccao de freeze). Quando o fecho de posicao e recusado - o caso medido do P0, em que MQL_TRADE_ALLOWED=0 recusa tambem o fecho - o journal publica FALHA AO FECHAR com o retcode, o comentario e o bit, para o operador nao acreditar que fechou o que nao fechou. O estado no arranque e publicado sempre, mesmo LIVRE, porque LIVRE e a informacao que autoriza confiar no silencio seguinte. Nenhum limite, lote, alvo, stop, spread, preco, regra de entrada ou de saida, ou parametro de risco foi alterado: acrescenta um interruptor que so pode REDUZIR actividade (bloquear entradas e fechar posicoes) e nunca abrir ou aumentar exposicao. " +
                          "v1.2.175 (06/11/2026) - P2: o ADX podia ficar ausente para sempre num simbolo, com o veto a ser fail-open silencioso. MEDIDO no journal vivo as 15:22:00 de 06/11, grafico USDCNH H1, build v1.2.174: [ADX] SEM LEITURA | USDCNH | CopyBuffer failed | Error=4807 | BarsCalculated=-1 | tratado como neutro (fail-open). A leitura do codigo mostrou duas coisas: (a) o P1.91 acertou em tentar o CopyBuffer quando BarsCalculated devolve -1, mas o handle criado na MESMA chamada ainda nao tem uma barra calculada, porque o MT5 calcula o indicador de forma assincrona - a primeira leitura de cada simbolo cai sempre neste ramo; e (b) a cache por simbolo do P1.85 so deitava fora a entrada quando o valor era provado de outro simbolo ou impossivel, NUNCA por tempo - logo um handle recusado com 4807 ficava preso ate ao fim da sessao, aquele simbolo nunca voltava a ter ADX e o veto do ADX_OK ficava em fail-open permanente. E o mesmo defeito que o P1.118 e o P1.135 corrigiram no ATR. Correcao minima, so de leitura de indicador: a primeira falha sem barras de cada simbolo passa a ser datada; se a MESMA falha durar ADX_STALE_RECREATE_SEC=120 s, a entrada sai da cache (ADXCacheDrop, que ja existe desde o P1.113) e a leitura seguinte cria handle novo, com uma linha [ADX] HANDLE MORTO que publica o erro, as barras calculadas e ha quantos segundos falha; uma leitura com exito limpa a marca, logo o caminho normal nao muda; e a primeira falha passa a dizer [ADX] HANDLE NOVO | handle criado nesta leitura: indicador a aquecer, em vez de sugerir um evento passageiro. Nenhum limite, lote, alvo, stop, spread, preco, regra de entrada ou de saida, ou parametro de risco foi alterado: muda de ONDE vem o ADX quando o handle nao serve e a partir de quando se tenta outro handle. Aviso de medicao: o ADX pode passar a existir em simbolos onde estava ausente ha horas, portanto os PF medidos tem de ser re-medidos, pela mesma razao do P1.91. " +
                          "v1.2.174 (06/11/2026) - P6: a linha [CONFIG] publicava parametros de risco que NAO estao em vigor, e um operador podia planear a conta real com eles. MEDIDO no journal do backtest B-032 e no journal vivo dos 13 graficos: a linha saia como [CONFIG] Perfil: Conservative | Lot=0.01 | SL=80 | TP=160 | MaxDD=3.0% | Trades=5, enquanto os graficos estao anexados com StopLossPoints=300, TakeProfitPoints=600, MaxDrawdownPercent=15.0, MaxTradesPerDay=100 e RiskPercent=1.0. A suspeita inicial era que alguem sobrescrevia a geometria de risco; a leitura do codigo REFUTOU a suspeita e provou o contrario: CConfigManager::GetProfile() nao tem um UNICO consumidor em toda a arvore (zero ocorrencias fora da propria definicao) e as estruturas ConfigSet e m_profiles nao saem de Enterprise/ConfigManager.mqh, portanto o catalogo dos 7 perfis nunca entra numa decisao. Quem manda no stop, no alvo e no lote e o GetProfile que nao existe e sim os inputs de Core/Config.mqh, consumidos por ExecutionEngine.mqh (slBase em 353, slPontos/tpPontos em 657-658) e OrderManager.mqh (48-49 e 133-134). Ou seja: o EA opera SL 300 e TP 600 e a linha dizia 80 e 160. Correcao, so de observabilidade: GetStatus passa a publicar o perfil como CATALOGO de referencia e a acrescentar um bloco EM VIGOR com StopLossPoints, TakeProfitPoints, MaxTradesPerDay, MaxDrawdownPercent, RiskPercent e MaxDailyLossUsd. Nenhum limite, lote, alvo, stop, spread, preco, regra de entrada ou de saida, ou parametro de risco foi alterado: o catalogo continua a existir e continua a nao decidir, exactamente como antes, e o que muda e que a linha deixa de poder ser lida como se decidisse. " + 
                          "v1.2.173 (06/11/2026) - P1.137: o [ATR] IDENTIDADE ERRADA acusava troca de serie num vies de CALCULO, e a falha provada esperava 10 minutos antes de voltar a tentar. MEDIDO no journal do backtest B-032 com o build v1.2.172 (XAUUSD H1, 2026.08.01 a 2026.11.05, Modelo M1 OHLC, 359831 ticks, 33min02s): 5 linhas IDENTIDADE ERRADA em 92 dias, com doHandle=15.890000 contra daSerie=22.774173 em XAUUSD (racio 0.698) e doHandle=0.000350 contra daSerie=0.000511 em USDSGD (racio 0.685) - o MESMO racio em dois instrumentos sem relacao nenhuma. Um racio constante entre pares nao relacionados e vies de CALCULO e nao troca de identidade, que teria de ser diferente por instrumento. Causa por leitura do codigo: o ATRFromRates aquecia a media de Wilder com apenas period*3+3 = 45 barras, o que depois da semente SMA deixa 31 iteracoes, logo o peso que resta a semente e (13/14)^31 = 10 por cento e o valor da serie sai cerca de 30 por cento abaixo do ATR do handle, que usa a serie inteira. CORRECAO 1: a janela de aquecimento passa a period*20+10 = 290 barras, residuo (13/14)^275 na ordem de 1e-9, e o ATRFromRates converge para o iATR. CORRECAO 2, no mesmo modulo: ATRIdentityFail passa a zerar g_atrIdStamp[slot] na falha PROVADA, portanto depois de ATR_IDENTITY_MAX_FAIL (2 leituras) o simbolo cai em rates-only ja na leitura SEGUINTE, em vez de esperar os 600 s do portao. EFEITO MEDIDO no A/B com o MESMO .ini e o MESMO .set, unica variavel a alteracao: B-032 (v1.2.172) equity 10257.16 e lucro +257.16; v1.2.173 equity 10250.62, lucro +250.62, 60 trades (32 ganhos, 2 perdas), WR 53.33 por cento, PF 2.02, MaxDD 138.95 USD, Sharpe 1.26, Expectancy 4.18 - delta de -6.54 USD, isto e -0.06 por cento do capital e -2.5 por cento do lucro, dentro do ruido da simulacao. No journal do run novo as 5 linhas IDENTIDADE ERRADA que restam sao TODAS com causa real (doHandle a devolver o PRECO, 4062.77 contra 16.26, e dois casos 26 por cento acima da tolerancia de 25 por cento), portanto a guarda continua a disparar onde deve e deixou de disparar onde era so semente curta. Nenhum limite, lote, alvo, stop, spread, preco, regra de entrada ou de saida, ou parametro de risco foi alterado: muda quantas barras aquecem uma media e quando uma falha provada volta a ser medida. " + 
                          "v1.2.167 (05/11/2026) - P1.131: fechar os dois relogios que ainda mediam tempo com TimeCurrent() no AIConnector, depois de o P1.127 e o P1.128 terem corrigido os portoes de falha. Nao eram a prova de reconexao, mas mentiam com o broker em baixo: (1) g_aiStateWhen, o cache de estado de IA por simbolo usado pelo [RESUMO] em Monitoring/OperatorBrief.mqh, era gravado e lido com TimeCurrent(), que e tempo do SERVIDOR e congela quando o link cai, logo a idade publicada como ha Ns parava de avancar exactamente quando o operador mais precisa dela, e o mesmo ficheiro passou a medir tempo com dois relogios diferentes depois do P1.127 - nesta sessao o servidor marcava 2026-11-06 01:25 e o computador 2026-11-05 20:25, 18000 s de diferenca; (2) o portao logOnce de 1800 s do LoadAIPrediction tambem usava TimeCurrent(), logo as linhas de diagnostico do carregamento de previsao ficavam mudas com o broker em baixo. Correcao: AIConnector.mqh passa a ter o prototipo de AIClockRelogio no topo (a funcao esta definida mais abaixo) e os dois sitios passam a AIClockRelogio, e OperatorBrief.mqh mede a idade com o mesmo relogio que a gravou. Nenhum valor destes entra numa decisao de trade, so em impressao; no tester tudo continua em TimeCurrent, ou seja tempo modelado. Nenhum limite, lote, alvo, stop, spread, preco, regra de entrada ou de saida, ou parametro de risco foi alterado. " +
                          "v1.2.166 (05/11/2026) - P1.129: o EA enviava a MESMA notificacao push uma vez por GRAFICO. MEDIDO em Common/Files/Notifications.log (2000 ultimas linhas): [SISTEMA] EA finalizado (reason=9) 14 vezes as 20:26:51 e 13 vezes as 20:40:11, [SISTEMA] EA finalizado (reason=2) 14 vezes as 20:05:05, e [RELATORIO] Profit=0.00 | Trades=0 | WinRate=0.00% 14 vezes as 20:32:43 mais 12 vezes as 20:40:47; o journal do terminal mostra a mesma linha as 20:29:32.969. Causa medida por leitura do codigo, com duas fontes: (1) o relatorio diario comparava TimeCurrent() com g_lastDailyReport, uma ancora POR INSTANCIA que nasce a zero em cada carga, logo as 14 instancias enviavam no primeiro tick depois de cada recarga; (2) o OnDeinit chamava SendSystemAlert sem portao nenhum, e a recarga de template acorda as 14 instancias no mesmo segundo. Correcao, so de notificacao: o relatorio passa a exigir o portao por CONTA (relatorio_diario, 23 h) e o EA finalizado passa a exigir, nos motivos SIMULTANEOS (REASON_RECOMPILE, REASON_ACCOUNT, REASON_TEMPLATE e REASON_CLOSE), a eleicao de dona do pipeline ja usada pelo [STOP] do P2.14 mais o portao por conta de 120 s por motivo; os outros motivos ficam so no portao. O cooldown e a deduplicacao do CNotificationCenter continuam por instancia DE PROPOSITO, porque ABERTURA e FECHAMENTO sao eventos do grafico que executou e nao da conta. Fica registado como residual que a PRIMEIRA utilizacao do ficheiro do portao pode deixar passar mais do que uma instancia no mesmo segundo, a licao do P2.14, e que o conteudo do relatorio continua a ser o da instancia que o envia. Nenhum limite, lote, alvo, stop, spread, preco, regra de entrada ou de saida, ou parametro de risco foi alterado. " +
                          "v1.2.165 (05/11/2026) - P1.128: a metade FALHA do rasto de reconexao continuava muda por um TERCEIRO relogio congelado. MEDIDO nesta sessao, com o gateway parado entre as 20:16:40 e as 20:23:00: 83 tentativas falhadas, recuperacao automatica as 20:23:00.290 e nenhuma linha de falha no mesmo intervalo. As causas eram TimeCurrent(), que CONGELA quando o link ao broker cai, em tres sitios: o portao por conta em Monitoring/AccountLogGate.mqh, o ramo de erro HTTP diferente de 200 do AI/AIConnector.mqh, com janela unica de 1800 s por conta, e o poll de 15 s com o teste de frescura, que comparavam TimeCurrent() com um valor gravado por AIClockRelogio(); medido nesta sessao, 2026-11-06 01:25 no servidor contra 2026-11-05 20:25 local, a diferenca era de 18000 s. Correcao: os tres sitios passam a medir com AIClockRelogio (TimeLocal em producao, TimeCurrent no tester), a janela do ramo de transporte passa a 300 s e a dos codigos HTTP reais fica em 1800 s. Provado depois da correcao: falha visivel as 20:29:09 e as 20:34:09 e recuperacao as 20:35:04, sem intervencao. Nenhum limite, lote, alvo, stop, spread, preco, regra de entrada ou de saida, ou parametro de risco foi alterado. " +
                          "v1.2.164 (05/11/2026) - P1.127: a reconexao ao gateway existia mas era INVISIVEL, e ficava parada exactamente quando o broker caia. MEDIDO nesta sessao: o gateway Python em 127.0.0.1:9011 foi parado as 20:08:11 e voltou a subir as 20:11:10; os 13 graficos bateram-lhe com HTTP 200 em segundos e o journal publicou '[AI] GATEWAY RECUPERADO | USDCNH | H1 | falhas=15 | cego=367s | resposta=357B | sem intervencao' as 20:11:13 - a reconexao funciona sem reanexar, sem reiniciar o terminal e sem tocar no grafico. O que NAO funcionava era o rasto: entre as 20:08:11 e as 20:11:13 nao saiu uma unica linha '[AI] GATEWAY falhou'. Tres causas, todas de relogio e de portao de log, nenhuma de risco. (1) A condicao da linha de falha era 'TimeCurrent() - lastWrErrLog >= errLogSec'; TimeCurrent() e tempo do SERVIDOR e so avanca com ticks, portanto com a ligacao ao broker em baixo ficava parado, a diferenca dava 0 e a linha nunca saia. (2) O portao por conta era 21600 s (1x/6h) para TODOS os codigos, logo um 5201 ja publicado antes emudecia seis horas - a queda inteira passava sem rasto. (3) O poll do gateway e o 'cego=Ns' da recuperacao usavam o mesmo relogio congelado, portanto o poll deixava de disparar durante a avaria e o tempo publicado nao era o tempo real. Correcao: nasce AIClockRelogio(), que devolve TimeLocal() em producao (relogio do computador, avanca sem ticks) e TimeCurrent() dentro do Strategy Tester, para o backtest continuar a medir tempo MODELADO exactamente como antes; o portao de log da falha passa a depender da classe - 4014/4060/5200 (configuracao, so o operador cura) ficam em 6 h, 5201/5202/5203 (transporte) passam a 300 s; o portao da linha '[AI] GATEWAY RECUPERADO' passa de 1800 s para 300 s, para uma segunda queda na mesma meia hora nao ficar muda; e o teste de frescura MaxPredictionAgeSec usa o mesmo relogio do ultimo poll, para os dois lados da comparacao nao virem de relogios diferentes. Nenhum limite, lote, alvo, stop, spread, preco, regra de entrada ou de saida, ou parametro de risco foi alterado: muda que relogio mede o tempo e quanto tempo um aviso fica calado. " +
                          "v1.2.163 (05/11/2026) - P1.126: o EA nao sabia reconectar sozinho ao gateway de IA e pagava 30 min por um engasgo. MEDIDO nesta sessao com o gateway Python em 127.0.0.1:9011: com o processo no ar o EA recebia 200 e inferencia real; ao PARAR o processo o journal passou a 'resposta NAO-HTTP' (1001/1003) e voltou a 200 sozinho assim que o processo subiu - esse caminho ja se curava, porque 1001/1003 nunca armaram cooldown. A avaria estava nos outros dois: (1) 5202 (TIMEOUT) estava classificado como erro de CONFIGURACAO e armava 1800 s de cegueira ao terceiro timeout seguido, quando um backend que engasga produz exactamente timeouts (inferencia pesada, disco, primeira chamada a frio) - um engasgo custava meia hora de IA mesmo depois de o servidor voltar; passa a perna TRANSITORIA com escada 60/120/300/600/900 s, que volta a tentar; (2) a credencial (401/403) esperava 1800 s fixos, portanto um token corrigido pelo dono so era apanhado meia hora depois - passa a mesma escada, 15 min no pior caso. 4014/4060/5200 continuam nos 1800 s porque so o operador os cura, e 5201/5203 continuam SEM cooldown porque e o que um gateway MORTO devolve. Um HTTP 200 com corpo util passa a zerar TODO o estado de falha explicitamente, em vez de depender do ramo anterior, e publica uma vez '[AI] GATEWAY RECUPERADO | simbolo | tf | falhas=N | cego=Ns | resposta=NB | sem intervencao' - a evidencia medivel de que voltou sozinho, sem reanexar e sem reiniciar o terminal. Os textos de diagnostico de 5201/5202/5203 deixam de dizer 'erro nao classificado', e 5202 deixa de dizer 'URL nao permitida pela lista'. Nenhum limite, lote, alvo, stop, spread, preco, regra de entrada ou de saida, ou parametro de risco foi alterado: muda quando o conector volta a tentar, o que limpa e o que publica. " +
                          "v1.2.162 (05/11/2026) - P1.125: o gate de IA nao podia ser satisfeito por NENHUM simbolo, com ou sem gateway. MEDIDO no journal de 05/11: 25 linhas [VALIDATION] BLOCK | AI (AUDUSD, USDJPY, NZDUSD, USDCAD e USDSEK, entre as 01:00 e as 14:54), ZERO linhas AI OK e ZERO linhas [ADV AI] em todo o dia, e a sonda ao gateway a devolver HTTP 401 no root e nos 11 simbolos, com AIGatewayToken vazio nos 13 graficos. Causa por leitura do codigo: em GetAIConfidence o teto do fallback (AIUnavailableConfidenceCap=40) era aplicado quando AIGateRequired() era VERDADEIRO, isto e exactamente no modo em que a IA e obrigatoria (AllowTradeWithoutAI=false e EnableAutonomousMode=false); 40 < MinAIConfidence=60, logo AITradeAllowed devolvia false SEMPRE - com gateway a responder score 95, com gateway a responder 401, ou sem gateway nenhum. A documentacao do Config.mqh manda capar o FALLBACK (o numero de indicador com nome de IA), nao a leitura real, e o codigo fazia o inverso. CORRECAO: GetAIConfidence passa a marcar aiReal, verdadeiro quando LoadAIPrediction devolve previsao com sinal diferente de UNAVAILABLE, e o teto passa a valer so quando aiReal e falso. Com IA real o score vale o que medir; sem IA o score continua capado em 40 e o gate continua fechado, que e o comportamento pedido em 23/10/2026. Nenhum limite, lote, alvo, stop, spread, RR, regra de entrada ou de saida muda. FICA REGISTADO, medido: enquanto o gateway responder 401 e nao houver token, o EA continua SEM poder abrir posicao em NENHUM simbolo - falta token no gateway ou decisao do dono para EnableAutonomousMode=true (IA consultora). Compilado 0 errors / 0 warnings. " + "v1.2.161 (05/11/2026) - P1.123: o EA esteve 24 h sem abrir posicao porque os handles do sinal eram criados e libertados a cada chamada. MEDIDO no journal de 04/11 19:00 a 05/11 19:40: 13 sinais BUY, 28 sinais SELL e 60 linhas [SCANNER] SIGNAL OK, com ZERO entradas; e a MESMA EMA=44.60460 a sair para AUDUSD, USDJPY, GBPUSD, USDCAD e EURUSD dentro da mesma hora, com a serie 26.80 -> 29.23 -> 31.51 -> 33.82 -> 44.60 -> 51.61 ao longo do dia - familia 0-100 (RSI/ADX) lida no buffer da EMA200 de tendencia. Cada GetSignal criava iMA x2 + iRSI e libertava-os no mesmo instante, para 11 simbolos por ciclo (~33 slots reciclados por ciclo); o terminal reutiliza os slots libertados e os handles de vida longa (EMA de tendencia, ADX, ATR) passaram a apontar para indicadores de outro tipo. Com a EMA de tendencia a devolver lixo, ScenarioTrendGate responde contramao vetada a 100% dos sinais (TREND SELL USDCAD ADX=43.7, TREND SELL USDSEK ADX=36.9, TREND BUY USDJPY ADX=31.3), e o ADX do proprio grafico aparecia como 0.00. CORRECAO: cache de handles por simbolo no SignalCore (SIG_CACHE_MAX=64), criados uma vez com XAI_WaitSeriesReady, descartados quando a copia falha, libertados no OnDeinit por ReleaseSignalHandles. Nenhum limite, regra de entrada/saida, lote, alvo, stop, spread ou RR muda. Compilado 0 errors / 0 warnings. " + "v1.2.160 (05/11/2026) - P1.119/P1.122: o ATR nao esta morto, falha nos MESMOS ciclos em que o ADX e o RSI falham, e a linha de falha nao dizia qual das duas causas. MEDIDO com a sonda Scripts/XAI_AtrDiag.mq5 v1.010 no grafico AUDUSD,H1 as 19:16 de 05/11, 14 handles pedidos por script: NAO existe deduplicacao e NAO existe ligacao a serie errada - handle 10 XAUUSD com barsCalc=60371 igual as barrasSerie, handle 11 AUDUSD 100013, handle 12 USDCNH 66891, handle 20 USDCZK 72095, handle 21 USDBRL 2206, cada um com as barras do SEU simbolo; o mesmo par devolve o mesmo handle (C1 igual=SIM), outro par devolve outro handle (C2/C3 igual=NAO) e o periodo 15 abre um handle novo (D1 handle=24, igualAoDe14=NAO). A hipotese de deduplicacao por nome+periodo+parametros fica REFUTADA no contexto de script. Do lado do EA, medido no journal do mestre USDCNH,H1 entre as 18:51:02 e as 19:07:18: a MESMA instancia alterna [CENARIO] USDCNH | ATR%=0.03 (leitura boa, coerente com bid 6.6656) e ATR%=sem leitura(atr=0.000000,bid=6.665560) a cada cerca de 90 s, portanto o ATR nao esta permanentemente a zero. As ondas de 60 em 60 minutos de [ATR] SEM LEITURA e de [ATR] HANDLE MORTO sao o portao de 3600 s do ATRLogNoRead a rearmar, nao uma recorrencia horaria do defeito. Nos ciclos em que o ATR falha o MESMO ciclo falha tambem o ADX e o RSI: [DATA] SEM LEITURA | USDCHF, USDCAD, NZDUSD, USDJPY e USDSEK entre as 19:00:35 e as 19:01:11 de 05/11, todos com ATR=0.000000, RSI=0.00 e o MESMO ADX=51.17 - a assinatura ja registada no P1.113, agora com cinco graficos no mesmo segundo. O ATR a zero e portanto vitima do mesmo evento que contamina o lote de indicadores, e nao um handle que nunca aquece. Correcao, so de diagnostico: o ramo CopyBuffer sem barras do GetATR passa a publicar handle, barrasSerie, barrasGrafico e serieSync ao lado de barsCalc e do bid, para a proxima medicao distinguir serie sem barras de handle preso a outra serie sem precisar de sonda externa, e a linha [ATR] LEITURA SUSPEITA passa a publicar o handle. Nenhum limite, lote, alvo, stop, spread, preco, regra de entrada ou de saida, ou parametro de risco foi alterado: muda o texto de duas linhas de diagnostico. " + "v1.2.159 (05/11/2026) - P1.121: o diagnostico existia mas nao podia ser lido. MEDIDO nos ficheiros do portao em Common\\Files: o ATRLogNoRead gastou a vez de XAUUSD as 15:12:30.864 e a de USDCNH as 15:12:31.846 (tag atr_no_read_<par>), e a janela e de 3600 s por CONTA, portanto o build seguinte nao tinha como voltar a falar desses dois pares durante uma hora - foi o que aconteceu entre as 15:12 e as 15:28 de 05/11. A chave do portao nao levava nada que mudasse entre builds, logo um build antigo calava um build novo. Correcao, so de diagnostico: as tres chaves do ATR (atr_no_read_, atr_handle_morto_ e atr_absurdo_) passam a incluir a marca de COMPILACAO __DATETIME__, portanto cada build fala uma vez por simbolo por conta e um build antigo nao gasta a vez do novo; a janela de 3600 s mantem-se, logo nao ha aumento de ruido dentro do mesmo build. Nenhum limite, lote, alvo, stop, spread, preco, regra de entrada ou de saida, ou parametro de risco foi alterado. " + "v1.2.158 (05/11/2026) - P1.120: o [CENARIO] escondia PORQUE nao havia leitura do ATR. MEDIDO no journal do expert as 15:26:31.831, 15:28:14.015, 15:26:43.146 e 15:28:35.864 de 05/11, build v1.2.157, grafico mestre USDCNH,H1: [CENARIO] XAUUSD | ADX=25.8 | ATR%=sem leitura e [CENARIO] USDCNH | ADX=51.6 | ATR%=sem leitura, embora os mesmos dois pares tivessem publicado ATR%=0.55 as 14:55:12 e ATR%=0.54 as 15:01:35 na MESMA instancia. O motivo ficou invisivel por duas razoes ao mesmo tempo: (a) o portao de 3600 s do ATRLogNoRead ja tinha gasto a vez de XAUUSD e USDCNH no reload das 15:12:30.864 e 15:12:31.846, logo nenhuma linha [ATR] SEM LEITURA nova saiu nas duas horas seguintes; (b) a string sem leitura era TEXTO FIXO em ScenarioAtrPctStr e nao distinguia as duas causas possiveis do -1.0 devolvido por MarketVolatilityPercent - atr<=0.0 lido do GetATR, ou SymbolInfoDouble(simbolo,SYMBOL_BID)<=0.0 -, o que deixava a medicao seguinte a adivinhar qual das duas era. Correcao, so de diagnostico: ScenarioAtrPctStr passa a publicar sem leitura(atr=<valor>,bid=<valor>) e o ramo CopyBuffer sem barras do GetATR passa a publicar tambem o bid, para o proximo ciclo nomear a causa (ATR a zero, preco a zero, ou handle sem barras) em vez de a supor. Nenhum limite, lote, alvo, stop, spread, preco, regra de entrada ou de saida, ou parametro de risco foi alterado: muda o texto de uma linha de diagnostico, que antes nao dizia nada. " + "v1.2.157 (05/11/2026) - P1.118: o handle do ATR que nunca aquece nunca era substituido, e o ATR desse simbolo ficava a zero para sempre. MEDIDO no reload de 05/11 com a v1.2.156 recem-instalada: as 15:12:30-15:12:33 os 13 graficos escrevem [ATR] SEM LEITURA | <par> | CopyBuffer sem barras | barsCalc=-1 | erro=4807 (aquecimento normal, e o P1.108 proibe libertar o handle neste ramo); mas as 15:14:25 o mestre ainda publicava [CENARIO] XAUUSD | TENDENCIA_FORTE | ADX=25.8 | ATR%=sem leitura e as 15:14:47 [CENARIO] USDCNH | ATR%=sem leitura - o proprio simbolo do grafico mestre, mais de dois minutos depois do arranque. As 15:18:10 a sonda XAI_AtrDiag, corrida no MESMO grafico USDCNH,H1, leu os dois com um handle NOVO: XAUUSD copy=1 atr=22.476429 atrPct=0.5485 bars=60369 e USDCNH copy=1 atr=0.002087 atrPct=0.0313 bars=66887. A serie existe e o dado esta la: o handle em cache e que nunca aqueceu. Este ramo devolve 0.0 sem valor, logo a guarda de plausibilidade do P1.112 nao o ve e o ATRCacheDrop do P1.117 nunca dispara - era a metade que faltava do sintoma ATR%=sem leitura. Correcao, respeitando o P1.108: NAO se liberta no primeiro CopyBuffer falhado. Passa a haver uma marca de primeira falha por simbolo (ATRStaleSlot/ATRStaleExpired, ATR_STALE_RECREATE_SEC=180) e so quando a MESMA falha dura mais de 180 s a entrada sai da cache, uma vez, com portao de 60 s (ATRCacheDropAllowed) e uma linha [ATR] HANDLE MORTO com barsCalc, erro e o grafico. Uma leitura com exito limpa a marca (ATRStaleClear), portanto um handle que aquece tarde nunca e deitado fora. Nenhum limite, lote, alvo, stop, spread, preco, regra de entrada ou de saida, ou parametro de risco foi alterado. " +
                         "v1.2.156 (05/11/2026) - P1.117: o ATRCacheDrop() do P1.113 estava escrito e nunca era chamado, logo o handle preso a serie de OUTRO instrumento ficava na cache para sempre e o par nunca sarava. MEDIDO no journal do expert no reload do perfil XAI_P216_LIVE as 13:53:25.943 de 05/11, build v1.2.155, 13 linhas em 240 ms, uma por grafico: [ATR] SEM LEITURA | <par> | CopyBuffer sem barras | barsCalc=-1 | erro=4807 em XAUUSD, USDSEK, USDJPY, USDCHF, NZDUSD, USDCNH, AUDUSD, GBPUSD, USDSGD, USDCAD, USDCZK, USDBRL e USDRUB. Imediatamente depois, 12 linhas [ATR] LEITURA SUSPEITA | <par> | ATR=22.068570 | grafico=<par> | devolvido=0.0 com o mesmo valor em todos os pares e a subir 0.107 em 32 s - uma unica serie a evoluir, a do grafico mestre, lida por todos. As 13:55:06.580 o [CENARIO] USDCNH ainda publicava ATR%=sem leitura, ou seja, o defeito nao sarava sozinho. A guarda de plausibilidade do P1.112 detectava a troca de serie mas nao a corrigia: faltava a chamada que o proprio comentario do P1.113 prometia, e esse comentario estava cortado a meio da frase em VolatilityFilter.mqh. Correcao: (1) nasce ATRCacheDropAllowed(string), portao por simbolo de 60 s (ATR_DROP_GATE_SEC) sobre g_atrDropSymbol/g_atrDropStamp, e o ramo de leitura suspeita passa a chamar ATRCacheDrop(symbol) antes de devolver 0.0 - a entrada envenenada sai da cache, a leitura seguinte cria um handle novo e o simbolo sara sem reiniciar o terminal; o portao impede um ciclo criar/libertar num par cronicamente mal servido, que repetiria o defeito do P1.108 (handle deitado fora antes de aquecer, ATR a zero e candle fora do dataset); (2) a linha [ATR] LEITURA SUSPEITA passa a publicar barsCalc, barrasSerie e barrasGrafico, para a proxima medicao provar a troca de serie (XAUUSD H1 e GBPUSD H1 nao tem o mesmo numero de barras) em vez de a inferir pela magnitude; (3) o comentario cortado do P1.113 foi completado. Nenhum limite, lote, alvo, stop, spread, preco, regra de entrada ou de saida, ou parametro de risco foi alterado. " +
                         "v1.2.155 (05/11/2026) - P1.116: o [CENARIO] publicava ATR%=sem leitura exactamente nos dois pares em que a sonda lia o ATR no MESMO segundo, e o getter do ATR nao dizia por que. MEDIDO no journal do expert as 23:45:11 e 23:51:42 de 04/11, build v1.2.154 recem-instalada, grafico XAUUSD,H1: [CENARIO] XAUUSD | TENDENCIA_FORTE | ADX=33.8 | ATR%=sem leitura, e as 23:45:15 e 23:51:45 [CENARIO] USDCNH | TENDENCIA_FORTE | ADX=26.8 | ATR%=sem leitura, enquanto na MESMA janela EURUSD, GBPUSD, USDJPY, NZDUSD, USDCAD e USDCHF publicavam ATR% entre 0.10 e 0.17. A sonda XAI_AtrDiag, corrida as 23:50:44 no grafico USDCNH,H1, leu no mesmo instante o ATR dos dois: XAUUSD atr=29.543571 atrPct=0.7145 com barsCalc=60353, copy=1, err=0, e USDCNH atr=0.002889 atrPct=0.0433 com barsCalc=66871, copy=1, err=0. Logo o zero NAO vem da serie nem do indicador - a serie esta sincronizada e o handle devolve barras -, vem do getter do EA, que tinha TRES saidas silenciosas a devolver 0.0 sem escrever nada: XAI_SymbolDataReady falso, handle INVALIDO, e CopyBuffer sem barras. O ADX tem ADXLogNoRead desde o P1.91 e o ATR nao tinha equivalente, e foi por isso que o defeito atravessou varios ciclos de medicao sem nome. Correcao, so de diagnostico: nasce ATRLogNoRead em Indicators/VolatilityFilter.mqh, com o mesmo portao por CONTA do AccountLogGate (1 linha por hora por simbolo), e os tres ramos de GetATR(string) passam a escrever [ATR] SEM LEITURA | <simbolo> | <motivo> | grafico=<_Symbol>, com o motivo a nomear o ramo (serie do simbolo nao provada, handle invalido, ou CopyBuffer sem barras com BarsCalculated e o codigo de erro) e o simbolo do GRAFICO no fim, para a proxima medicao nomear a instancia culpada em vez de a inferir. O zero devolvido nao muda: os tres ramos continuam a devolver 0.0 e MarketVolatilityPercent continua a traduzir isso como sem leitura. Nenhum limite, lote, alvo, stop, spread, preco, regra de entrada ou de saida, ou parametro de risco foi alterado. Nota de metodo: os tres ramos foram instrumentados ANTES de tocar na causa, para a causa ser lida no journal e nao suposta. " +
                          "v1.2.154 (05/11/2026) - P1.115: a guarda da EMA descartava a leitura CERTA e mantinha a contaminada. MEDIDO no journal do expert as 23:40:51 de 04/11, build v1.2.152 recem-carregada nos 16 graficos: [TREND] VALOR DE OUTRO SIMBOLO | AUDUSD | EMA=0.70084 | grafico=USDCNH. 0.70084 e a EMA200 H1 verdadeira do AUDUSD (bid 0.70188), logo o handle do par estava BOM e foi deitado fora, enquanto o handle do PROPRIO grafico - criado em OnInit antes de a serie do par existir - devolvia esse mesmo valor: a comparacao com o simbolo do grafico acusava o lado errado. A P1.113 e a P1.115 sao o mesmo mecanismo em pontos diferentes: um handle nascido antes de a serie existir fica preso a serie que estiver disponivel naquele instante, e isso atinge tambem o handle do grafico criado em OnInit. Correcao: a guarda passa a ser local ao simbolo - TrendEMAImplausivel recusa uma EMA200 H1 que esteja a mais de TREND_EMA_MAX_DEVIATION_PCT=50 por cento do bid do PROPRIO simbolo (nenhum par desta lista chega la; ouro ronda 0.7 por cento e o FX 0.1), deixa de comparar com o grafico e, quando o valor do grafico e impossivel, TrendChartHandleReset liberta e recria o handle em vez de manter o valor. Na mesma alteracao o gate de aquecimento do ADX passou de 2x para 3x o periodo, porque com menos barras o ADX sai inflado: medido as 23:40:48 de 04/11 em duas instancias no MESMO segundo, USDCNH ADX=83.12 e USDSEK ADX=83.04, enquanto a sonda XAI_IndicProbe lia 26.34 no USDCNH e 46.47 no USDSEK nos mesmos pares. Nenhum limite, lote, alvo, stop, spread, preco, regra de entrada ou de saida, ou parametro de risco foi alterado: um valor impossivel passa a ser ausencia de leitura em vez de um numero com aparencia de verdade. " + "v1.2.153 (05/11/2026) - P1.114: o portao de diagnostico do journal desligava-se sozinho quando a tabela enchia, e ficava desligado ate ao fim da sessao. MEDIDO pelo auto-teste DiagGateSelfTest.mq5 no journal do expert: depois de encher a tabela com 300 chaves, ele publicou [DIAGGATE-TEST] fim | chaves=256 | suprimidas=4 | falhas=4 | REPROVADO e C3 3000 repeticoes do ciclo -> 0 linhas, quando o mesmo ciclo, medido de tabela limpa, suprime. Causa por leitura do codigo: em Monitoring/DiagGate.mqh, DiagGateAllow fazia fail-open sempre que g_diagGateCount chegava a DIAG_GATE_MAX=256 - a partir da chave 257 cada chamada devolvia true sem sequer consultar a tabela -, e as cerca de 20 chamadas em ExecutionEngine, StateMachine, MarketScanner, RiskEngine, TradePipeline, CostGate, MarketIntelligence, NewsFilter e LearningHistory passavam a imprimir sem limite sem o dizer: o journal voltava a crescer e quem o lia concluia que o portao estava a funcionar. Correcao: em vez de devolver true, o portao evacua a chave usada ha MAIS tempo (campo novo lastUse mais DiagGateEvictLRU) e insere a nova, de modo que a supressao sobrevive com a tabela cheia. A evacuacao e auditavel: contador g_diagGateEvicted, campo evacuacoes= no DiagGateSummary e uma linha no journal, no maximo 1 por hora, a dizer que a tabela encheu e qual foi a decisao. Custo assumido e declarado: a chave evacuada volta a sair UMA vez quando for chamada de novo - e preferivel a perder o portao em silencio. O auto-teste passou a medir o contrato novo: o bloco que enche a tabela foi para o FIM (bloco F) e a contabilidade e lida por DELTA (suprimidasInicio, evacuacoesInicio), com F1 a provar que a chave nova sai com a tabela cheia, F2 que a tabela fica saturada em 256, F5 que a repeticao continua a ser suprimida e F6/F7 que a chave evacuada volta a sair uma vez e depois emudece outra vez. Nenhum limite, lote, alvo, stop, spread, preco, regra de entrada ou de saida, ou parametro de risco foi alterado: muda quantas linhas de diagnostico chegam ao journal, nao o que o EA decide. DEPOIS da correcao, o mesmo auto-teste, corrido no terminal as 23:43:57 de 04/11 sobre o build v1.2.153, publicou fim | chaves=256 | suprimidas=3009 | evacuacoes=55 | falhas=0 | APROVADO, e a chave evacuada medida foi S253. A primeira versao do bloco F exigia S0 e acusava FALHA com o portao correcto: era uma suposicao errada do teste, nao um defeito do codigo, porque os blocos A e C ja tinham chaves na tabela e a vitima e a mais antiga; o teste passou a descobrir a chave ausente por inspeccao (DiagGateFind) em vez de a supor. " +
                          "v1.2.152 (05/11/2026) - P1.113: sete simbolos liam o ADX, o RSI e o ATR de OUTRO instrumento, e por isso ficavam sem candle no dataset. MEDIDO no journal do expert as 23:16:40 de 04/11, build v1.2.151 recem-instalada nos 15 graficos: GBPUSD, USDJPY, AUDUSD, USDCAD, NZDUSD, USDCHF e USDCNH escreveram no MESMO segundo a linha [DATA] SEM LEITURA com ATR=0.000000, ADX=33.77 e RSI=82.72 - os tres numeros identicos ao centesimo nos sete pares -, e a linha anterior de cada um era [ATR] LEITURA SUSPEITA com ATR=29.454290 num par cotado a 1.34881, com o ATR% a chegar a 5222. 29.454290 e o ATR do OURO e 33.77 e 82.72 sao o ADX e o RSI do ouro. Nenhum mercado produz sete instrumentos com o mesmo ADX: o handle por simbolo foi criado enquanto a serie pedida ainda nao existia e ficou preso a serie de OUTRO instrumento; como nunca saia da cache, o simbolo nunca sarava e a barra nao era gravada, porque AI/DataLogger.mqh regressa no [DATA] SEM LEITURA antes do FileWrite. Correcao em tres pontos: (1) nasce Indicators/SymbolDataReady.mqh, que so declara a serie pronta com SymbolSelect, SymbolIsSynchronized, SERIES_SYNCHRONIZED e Bars() maior que 0, mais XAI_LeituraDeOutroSimbolo, que compara a leitura com a do simbolo do grafico; (2) GetATR(string), GetADX(string) e GetRSI(string) recusam a leitura quando a serie do simbolo pedido nao esta provada - devolvem 0.0 ou -1.0, valores que o consumidor ja trata como sem leitura, o mesmo caminho do aquecimento - e publicam no maximo 1 linha por hora por simbolo; (3) nascem ATRCacheDrop, ADXCacheDrop e RSICacheDrop, que deitam fora a entrada da cache quando o valor e provado de outro simbolo ou impossivel (ADX acima de 100), para a leitura seguinte criar um handle novo e o simbolo sarar sem reiniciar o terminal. O ramo de CopyBuffer sem barras continua a NAO libertar o handle, pela razao do P1.108: libertar durante o aquecimento impede o indicador de aquecer. Nenhum limite, lote, alvo, stop, spread, preco, regra de entrada ou de saida, ou parametro de risco foi alterado: um valor impossivel passa a ser ausencia de leitura em vez de um numero com aparencia de verdade. Aviso de medicao: com o ATR, o ADX e o RSI a funcionar pela primeira vez nos 10 simbolos nao-grafico, os PF medidos ate hoje tem de ser re-medidos, pela mesma razao que nos P1.91, P1.108 e P1.109. " + "v1.2.151 (05/11/2026) - P1.112: o ATR de OUTRO instrumento continuava a entrar na decisao como se fosse uma leitura valida. MEDIDO a 22:59:55 de 04/11, build v1.2.150 recem-instalada nos 15 graficos: [CENARIO] USDJPY | VOLATILIDADE_ALTA | ADX=33.3 | ATR%=18.38, e na base a MESMA barra 03:00 do servidor escrita duas vezes - uma com ATR=0.182 ADX=30.027 (correto, identico ao do proprio USDJPY) e outra com ATR=28.369 ADX=33.26630490148689, valores bit a bit iguais aos da linha XAUUSD da mesma barra. O preco estava certo (158.354 = bid do USDJPY), so a leitura de indicador veio do ouro, e com ela o cenario classificou VOLATILIDADE_ALTA, cortou o lote para x0.60 e alargou o alvo para x1.15 - decisao de risco tomada com a volatilidade de outro instrumento. A causa de fundo (qual instancia serve a serie do grafico a um simbolo estrangeiro) ainda nao esta isolada, portanto este ciclo nao a declara resolvida: fecha o EFEITO com uma guarda no unico ponto por onde o ATR entra no EA. GetATR(string) passa a recusar o valor quando ATR/preco excede ATR_MAX_PLAUSIBLE_PCT=5.0 - nenhum simbolo desta lista chega a 2% (ouro ~0.7%, FX ~0.13%), logo 5% so pode ser outro instrumento -, devolve 0.0 (o consumidor ja trata 0.0 como sem leitura, o mesmo caminho do aquecimento) e publica no maximo 1 linha por hora por simbolo com o ATR, o preco, o ATR% e o SIMBOLO DO GRAFICO, para a proxima medicao nomear a instancia culpada em vez de a inferir. O getter sem argumentos GetATR() delega em GetATR(_Symbol), logo a guarda cobre tambem o trailing, o breakeven, a parcial e o stopless. Nenhum limite, lote, alvo, stop, spread, preco, regra de entrada ou de saida, ou parametro de risco foi alterado: um valor impossivel passa a ser ausencia de leitura em vez de ser um numero com aparencia de verdade. " + "v1.2.150 (05/11/2026) - P1.109: o handle de indicador criado em OnInit lia OUTRO simbolo depois do reload do perfil. MEDIDO no journal do expert as 22:46:55 de 04/11, build v1.2.149, grafico USDJPY H1: [CENARIO] USDJPY | VOLATILIDADE_ALTA | ADX=33.2 | ATR%=17.97 | tendencia=RANGING | lote x0.60 | alvo x1.15. Os numeros nao pertencem ao USDJPY: o dataset gravado pelo proprio EA no mesmo candle diz USDJPY ATR=0.195 ADX=26.25 RSI=41.32 e XAUUSD ATR=28.39 ADX=33.16, e 28.39/158.354*100 = 17.93 (o ATR% impresso) enquanto 33.2 e o ADX do XAUUSD. O preco usado estava certo (158.354, bid do USDJPY), logo o defeito estava apenas na leitura dos indicadores, e so no simbolo DO GRAFICO: os 10 simbolos do scan leem por um handle por simbolo criado em runtime e sempre devolveram o valor certo, enquanto GetATR() e GetADX() do simbolo do grafico usavam o handle unico criado em OnInit, no reload do perfil. Duas consequencias medidas: (a) o [CENARIO] classificou o USDJPY como VOLATILIDADE_ALTA (ATR% 17.97 contra o teto ScenarioVolPctMax=2.0) e baixou lote para x0.60 e alargou o alvo para x1.15 com base na volatilidade do OURO; (b) toda a leitura do simbolo do grafico (trailing, breakeven, parcial, stopless) passou a usar o ATR de outro par. Correcao: GetATR(), GetADX() e GetRSI() deixam de ler o handle da instancia e passam a delegar em GetATR(_Symbol) / GetADX(_Symbol) / GetRSI(_Symbol), que usam a cache por simbolo criada em runtime; a versao antiga de cada funcao fica no ficheiro como GetATRInstance()/GetADXInstance()/GetRSIInstance() e HighVolatility passa a comparar o ATR com a media de 20 barras do MESMO handle. Nenhum limite, lote, alvo, stop, spread, preco, regra de entrada ou de saida, ou parametro de risco foi alterado: muda de que handle sai uma leitura de indicador. Aviso de medicao: os PF medidos ate hoje descrevem um EA em que o simbolo do grafico podia estar a ler o ATR/ADX de outro par, portanto tem de ser re-medidos tal como depois do P1.91 e do P1.108. " + "v1.2.149 (05/11/2026) - P1.108: o ATR multi-simbolo nunca aquecia, portanto 10 dos 11 simbolos do scan ficavam sem ATR e sem candle gravado. MEDIDO no journal do expert as 22:39:42 de 04/11, build v1.2.148: [DATA] SEM LEITURA | USDSEK | ATR=0.000000 | ADX=42.12 | RSI=42.99 e [DATA] SEM LEITURA | USDCNH | ATR=0.000000 | ADX=23.78 | RSI=43.21 - o ADX e o RSI chegaram com valor real e o ATR chegou a zero no MESMO candle, logo nao era aquecimento do par, era a leitura do ATR. Causa exacta por leitura do codigo: Indicators/VolatilityFilter.mqh, GetATR(string symbol) chamava iATR() e IndicatorRelease() na MESMA leitura, e o primeiro CopyBuffer de um handle recem-criado pode devolver 0 barras porque o MT5 calcula de forma assincrona - o handle era deitado fora antes de aquecer e a funcao devolvia 0.0 para sempre. E exactamente o defeito que o P1.85 (v1.2.96) corrigiu no ADX e que ficou por corrigir no ATR; o ADX hoje tem cache por simbolo e devolve 42.12 no mesmo instante. Dois efeitos medidos do ATR a zero: (a) o candle NAO e gravado no dataset, porque AI/DataLogger.mqh regressa no [DATA] SEM LEITURA antes do FileWrite, portanto o CSV do pipeline so recebia o simbolo do grafico; (b) em Core/ExecutionEngine.mqh:943 o armPts cai para StoplessArmMinPoints e a simulacao de RR corre com um R de 30 pontos em vez do R real do par, um fail-open no portao MinSimulationRR. Correcao: o handle passa a ser criado UMA vez por simbolo numa cache de 256 entradas (ATRSymbolHandle), nunca e libertado na leitura, o simbolo do grafico passa a usar o handle da instancia (como o ADX e o RSI) e a cache e limpa em InitATR (mudanca de timeframe) e em ReleaseATR. Nenhum limite, lote, alvo, stop, spread, preco, regra de entrada ou de saida, ou parametro de risco foi alterado: muda de onde sai uma leitura de indicador que estava a ser lida como ausente. Aviso de medicao: com o ATR a funcionar pela primeira vez nos 10 simbolos nao-grafico, os PF medidos ate hoje descrevem um EA com ATR ausente nesses pares e tem de ser re-medidos, pela mesma razao que o P1.91 deu para o ADX. " +
                          "v1.2.148 (05/11/2026) - P1.107: o [RESUMO] publicava o estado da IA sem dizer de QUE simbolo. MEDIDO no journal as 22:05:52 de 04/11, build v1.2.147, master (USDJPY,H1): o [RESUMO] escreveu IA=UNAVAILABLE 0.0% enquanto a instancia XAUUSD tinha, no mesmo instante, [AI] GATEWAY | XAUUSD | H1 | 1122 bytes | disponivel=true e [AI] PYTHON | XAUUSD | SELL | PRICE=4095.600 | CONF=55.70%. O P1.102 tornou o valor honesto - o resumo passou a ler o estado do simbolo do GRAFICO e nao o do ultimo visitado - mas o SUJEITO ficou invisivel: o master e o grafico USDJPY, que nao tem modelo publicado, logo o resumo diz UNAVAILABLE para sempre e quem o le conclui que a IA caiu. Correcao: o campo passa a IA(<SIMBOLO>)=<sinal> <conf>%, lendo _Symbol. Nenhum limite, lote, alvo, stop, spread, preco, regra de entrada ou de saida, ou parametro de risco foi alterado: muda o texto de uma linha de resumo. " +
                          "v1.2.147 (04/11/2026) - P1.102/P1.105/P1.106: tres leituras do journal que mentiam, todas de observabilidade. (1) P1.102 - o [RESUMO] publicava 'IA=UNAVAILABLE 0.0%' com uma previsao fresca na linha de cima. MEDIDO no journal as 21:27:55: a instancia (USDJPY,H1) escreveu '[AI] PYTHON | XAUUSD | SELL | CONF=76.80%' e, 5 s depois, 21:28:00, o [RESUMO] da MESMA instancia anunciou UNAVAILABLE - porque o pipeline percorre 11 simbolos numa volta e o slot AI_Symbol/AI_Signal e UNICO, logo o resumo lia o estado do ultimo visitado (USDCNH, recusado) e nao do par dono do grafico. Passa a existir uma cache por simbolo, SO de leitura para o resumo (32 slots, nao entra em decisao nem altera portao nenhum); o resumo mostra o estado do simbolo do grafico com a idade em segundos. (2) P1.105 - 55 linhas '[AI] GATEWAY | <simbolo> | H1 | 357 bytes' no dia diziam o tamanho e nao o que aquilo era; passa a levar 'disponivel=true/false', sem repetir o motivo (que continua 1x/hora na linha INDISPONIVEL). (3) P1.106 - o delta de contadores saia NEGATIVO depois de um reattach: MEDIDO as 18:13:56 '[SCANNER] RESUMO ... ADX(sem/ok)=-2951/-29135' quando o modulo de ADX recriou os contadores e o baseline publicado sobreviveu. O delta passa a zero e o baseline e reescrito com o valor atual. Nenhum limite, lote, alvo, stop, spread, preco, regra de entrada ou de saida ou parametro de risco foi alterado. " +
                          "v1.2.146 (05/11/2026) - P1.103: uma falha de TRANSPORTE do gateway trocava uma previsao FRESCA em memoria por um ficheiro local obsoleto. MEDIDO no journal de 04/11: 21:21:29.101 [AI] PREDICAO VENCIDA | XAUUSD | AGE=6787s e 21:21:44.446 [RESUMO] com IA=UNAVAILABLE 0.0%, enquanto a sonda ao MESMO endpoint devolvia available=true (XAUUSD SELL conf 81.0, price 4064.0). O ficheiro Data/prediction_XAUUSD.json esta parado desde ~19:28 porque quem o escreve e o pipeline Python, nao o EA; logo cada consulta falhada virava indisponibilidade e bloqueava a entrada ate ao poll seguinte. Correcao: quando AIUseGateway esta ligado, o gateway JA respondeu para ESTE simbolo e a previsao em memoria ainda esta dentro de MaxPredictionAgeSec, devolve-se a previsao em memoria e nao se le o ficheiro; o ficheiro continua a ser o plano B quando nao ha nada em memoria (arranque, modo legado, tester). Nenhum limite, lote, alvo, stop, spread, preco, regra de entrada ou de saida, ou parametro de risco foi alterado: sem previsao fresca o retorno continua false e a entrada continua bloqueada com AllowTradeWithoutAI=false. " + "v1.2.145 (04/11/2026) - P2.21: o log de notificacoes era ilegivel e crescia sem limite, e o contador de falhas contava cada mensagem duas vezes. MEDIDO em 04/11/2026 21:17 em Common/Files/Notifications.log: 53 200 689 bytes e 1 644 441 linhas, dos quais 41 491 blocos 'HEALTH MONITOR' de ~39.6 linhas cada - o bloco inteiro do HEALTH era UMA notificacao partida em 40 registos sem data, sem estado e sem dono, porque o FileWrite escrevia o detalhe com as quebras de linha intactas. A linha 1 do ficheiro real era 2026.08.14 00:00:00FAIL[RELATORIO] Profit=0.00: data, estado e mensagem colados, porque o separador implicito do FileWrite nao sai no ficheiro, logo nao havia forma de separar os campos. Medido tambem no journal do tester as 20:58:22: '[NOTIFY] Sent=0 | Failed=1156 | Push=ON | Telegram=OFF' - com push ligado e Telegram desligado o codigo incrementava m_failed_count no ramo do canal que falhou E outra vez no 'if(!anySent)' final, logo 1156 = 2 x 578 mensagens e o contador media o dobro. Correcoes, todas de observabilidade: (1) o detalhe passa a uma linha so, com quebras substituidas por ' / ' e tecto de 400 caracteres; (2) a linha do log passa a ser um campo unico ja delimitado por ' | ', independente do comportamento do FileWrite; (3) o ficheiro roda para Notifications.old.log acima de 8 MB; (4) o contador conta MENSAGENS sem canal, uma vez por mensagem. Nenhum limite, regra de entrada ou de saida, lote, alvo, stop, spread, preco ou parametro de risco foi alterado. " +
                          "v1.2.144 (05/11/2026) - P1.102: o throttle de log por CONTA deixava de filtrar sempre que o Strategy Tester estava a correr. MEDIDO: Common/Files/XAU_AI_PRO/loggate_ai_stale.bin continha 2026-09-09 20:00:00 - o tempo SIMULADO do job de backtest - enquanto o terminal vivia 2026-11-04 21:14; com um valor no passado, a condicao agora >= ultimo + janela e sempre verdadeira. Prova no journal da producao: duas linhas [AI] PREDICAO VENCIDA na mesma instancia com 20 s de diferenca (21:09:52.802 e 21:10:12.129) apesar da janela de 3600 s, e dezenas de ficheiros loggate_*.bin reescritos as 21:14:02-04. E a mesma causa das 129 linhas/dia que o P2.00 tentou travar. Correcao: o tester deixa de escrever nos ficheiros de gate partilhados e devolve SEMPRE true (cada passe tem o seu proprio journal; nao ha conta partilhada a proteger), pelo que a producao recupera o 1x/hora por tag e por conta. Nenhum limite, lote, alvo, stop, spread, preco, regra de entrada ou de saida, ou parametro de risco foi alterado. " + "v1.2.143 (05/11/2026) - P1.101: a leitura VENCIDA de um simbolo apagava o estado de IA de OUTRO simbolo. MEDIDO no journal de 04/11, depois do deploy da v1.2.142: as 9 linhas [AI] PREDICAO VENCIDA da sessao sairam TODAS da instancia XAU_AI_PRO (USDJPY,H1), nomeando XAUUSD (AGE=4666 s e a subir 15 s por 15 s), AUDUSD (AGE=152199 s) e USDJPY (AGE=153013 s, cerca de 42 h) - ficheiros Data/prediction_<SIMBOLO>.json obsoletos, lidos no ramo de fallback - e cada uma chamava ResetAIState(), que e um slot UNICO para toda a instancia. Na mesma janela, [AI] GATEWAY | XAUUSD | H1 | 1122 bytes e [AI] PYTHON | XAUUSD | SELL | CONF=71.20% eram seguidos de IA=UNAVAILABLE 0.0% no [RESUMO]: a previsao fresca do gateway era apagada pela leitura velha de outro par. Correcao: o estado global so e limpo quando o slot pertence ao proprio simbolo pedido (AI_Symbol==esperado) ou quando esta vazio, e a linha [AI] PREDICAO VENCIDA segue a mesma condicao; o primeiro aviso continua a sair com o mesmo texto, logo o facto nunca fica escondido. O valor devolvido para o simbolo pedido nao muda - continua false, e a entrada continua bloqueada com AllowTradeWithoutAI=false. Nenhum limite, lote, alvo, stop, spread, preco, regra de entrada ou de saida, ou parametro de risco foi alterado. " + "v1.2.142 (04/11/2026) - P1.100: duas correcoes de diagnostico no mesmo bloco, ambas encontradas no journal do proprio ciclo que fechou o P1.98. (1) O journal escreveu as 20:40:21 de 04/11, com o build v1.2.141 recem-instalado: '[AI] GATEWAY | HTTP 1003 | http://127.0.0.1:9011/api/ai/predict?symbol=XAUUSD&timeframe=H1 | backend fora do ar | WebRequest=LIGADO (a chamada SAIU) | corpo=0B'. 1003 nao e um codigo HTTP - o WebRequest devolveu um codigo de transporte e a classificacao por faixa (status >= 500) traduziu-o como backend fora do ar, que manda o operador procurar um servidor que nao falhou; a chamada seguinte, oito segundos depois, devolveu 1120 bytes e uma inferencia real. Passa a existir a faixa status > 599, testada ANTES da faixa 5xx, com o texto resposta NAO-HTTP (codigo devolvido pelo transporte, nao pelo servidor). (2) Em LoadAIPrediction havia dois if(logOnce) encadeados - o portao por conta AccountLogGatePodeImprimir ficava pendurado no primeiro e o segundo repetia a mesma condicao. Nao mudava o resultado (o portao so e consultado quando logOnce e verdadeiro), mas lia-se como se o portao pudesse ser saltado; a condicao fica so na linha de cima, com o motivo escrito. HG-01: o #property version do build v1.2.141 ficou em 1.340 em vez de 1.341 - a edicao do cabecalho nao chegou ao ficheiro e so foi detetada por leitura depois do deploy - e passa a 1.342, alinhado com EA_VERSION_STRING 1.2.142. Nenhum limite, regra de entrada ou de saida, lote, alvo, stop, spread, preco ou parametro de risco foi alterado: muda o texto de uma linha de diagnostico, uma condicao redundante e o numero de versao. " "v1.2.141 (04/11/2026) - P1.98: o EA publicava PRECO ZERO como se fosse previsao de IA. MEDIDO no journal as 20:31:39 de 04/11, build v1.2.140, grafico USDCNH H1: '[AI] PYTHON | USDCNH | NEUTRAL | PRICE=0.00000 | BUY=0.00% | SELL=0.00% | SCORE=0.00 | CONF=0.00%'. O gateway responde CORRECTAMENTE - a sonda Tools/gw_probe3.ps1 provou as duas ramificacoes no mesmo instante: USDCNH devolve HTTP 200 com available=false e reason='edge -0.1256 abaixo do minimo +0.0500 (acc 0.2680 vs palpite 0.3936)', enquanto XAUUSD devolve available=true, signal=SELL, confidence=70.0 e price=4061.64. O defeito esta no parser: ParsePredictionJSON nunca lia a chave available, portanto a recusa do walk-forward entrava como previsao valida - signal NEUTRAL, price 0.0, confidence 0.0 - e era publicada com preco zero. O fail-open vinha de AIEngine.mqh:512, que so bloqueia quando LoadAIPrediction devolve false ou o sinal e UNAVAILABLE/ERROR: uma recusa lida como 'IA presente e neutra' passava o portao de IA com AllowTradeWithoutAI=false. Correcao: o parser passa a extrair available e reason e, antes de qualquer escrita no estado global, available=false (ou '0') faz ResetAIState(), AI_Symbol vazio, AI_Signal='UNAVAILABLE' e devolve false, com uma linha [AI] INDISPONIVEL | simbolo | MOTIVO=razao do gateway limitada a 1 por simbolo por hora por conta (tag ai_unavail_simbolo, 3600 s). Sem a chave available nada muda, logo o ficheiro prediction_*.json local continua a ser lido exactamente como antes. Efeito: os 14 graficos sem modelo publicado deixam de publicar preco zero e passam a dizer que a IA esta indisponivel e por que, e o XAUUSD continua a publicar a inferencia real. Nenhum limite, regra de entrada ou de saida, lote, alvo, stop, spread, preco ou parametro de risco foi alterado: muda a leitura de um campo da resposta e o que acontece quando o gateway recusa. " "v1.2.140 (04/11/2026) - P1.97: a causa real do 'Proximo evento' vazio. MEDIDO no journal as 20:28:53 de 04/11, build v1.2.139, grafico USDCAD H1, com a resolucao do pais ja reposta: o bloco continuava a publicar 'Proximo evento:  (impacto=0)' e 'Min para evento: -1'. A causa nao estava no calendario - economic_calendar_list_values devolvia 30 releases na janela 04/11..12/11, truncado - estava na derivacao das moedas do simbolo: IntelSymbolCurrencies usava NewsSplitCsv, que divide uma lista CSV por virgula, e aplicada a 'USDCAD' devolvia um unico elemento 'USDCAD', que nunca iguala a moeda de um evento ('USD' ou 'CAD'). Com o filtro dentro do scan (P1.95) o resultado passou a ser zero de forma deterministica em todos os 13 graficos. Correcao: IntelSymbolCurrencies passa a delegar em SymbolNewsCurrencies, que ja existe no NewsFilter.mqh desde antes e faz a derivacao correcta (EURUSD -> EUR+USD, XAUUSD -> USD, US30 -> USD) incluindo a limpeza de sufixos; GetNextEventForSymbol passa a usar a mesma funcao em vez de repetir a heuristica. Efeito: GetNextEventForSymbol deixa de devolver evento vazio, logo BlockHighImpactNewsMin e os minutos para o evento passam a ter dado real. Nenhum limite, regra de entrada ou de saida, lote, alvo, stop, spread, preco ou parametro de risco foi alterado: muda a derivacao de uma lista de moedas a partir do nome do simbolo. " "v1.2.139 (04/11/2026) - P1.96: o 'Proximo evento' do retrato de MARKET INTELLIGENCE saia sempre vazio. MEDIDO no journal as 20:24:18 de 04/11, grafico USDCZK H1, build v1.2.138: 'Proximo evento:  (impacto=0)' e 'Min para evento: -1' enquanto economic_calendar_list_values devolvia dezenas de releases nos 7 dias seguintes. Causa exacta, por leitura do codigo depois da correcao do P1.95: em RefreshEconomicCalendar a variavel MqlCalendarCountry cn era DECLARADA mas nunca preenchida - a chamada CalendarCountryById(ev.country_id, cn) desapareceu na reescrita que moveu o filtro de moeda para dentro do scan - portanto cn.currency era a string vazia, IntelCurrencyRelevant('') devolvia false para TODOS os eventos e o 'continue' descartava a lista inteira antes de encher g_nextEvents. O P1.95 (filtro aplicado depois de truncar a 20 vagas) era real mas nao era a causa do vazio; com o filtro dentro do scan e sem o pais resolvido o resultado passou a ser zero de forma deterministica. Correcao: reposta a resolucao do pais antes do filtro, com o mesmo padrao do NewsFilter.mqh (CalendarValueHistory -> CalendarEventById -> CalendarCountryById). Efeito: GetNextEventForSymbol deixa de devolver evento vazio, logo BlockHighImpactNewsMin e os minutos para o evento passam a ter dado real. Nenhum limite, regra de entrada ou de saida, lote, alvo, stop, spread, preco ou parametro de risco foi alterado: muda a leitura de um campo de calendario que estava a ser lido como vazio. " "v1.2.138 (04/11/2026) - P2.24: o retrato de MARKET INTELLIGENCE existia, era calculado em cada tick e NUNCA era publicado. MEDIDO por leitura de codigo depois do reload dos 13 graficos do perfil XAI_P216_LIVE: PrintMarketIntelligence() esta definida em Filters/MarketIntelligence.mqh e nenhuma das 116 fontes do EA a chamava - zero ocorrencias fora da propria definicao - logo sessao, dia, feriado, minutos para fechar a sessao e o mercado, proximo evento economico e minutos para ele, score 0-100, nivel e o veredicto de pode negociar ficavam calculados em memoria e nunca escritos. O segundo sintoma vinha do mesmo ponto: o [INTEL LOT] de Core/ExecutionEngine.mqh so sai quando GetIntelligenceLotFactor() devolve menos de 1.0, isto e quando o score cai abaixo de 70, portanto um mercado normal nao deixava rasto nenhum de que a camada de inteligencia estava viva. Correcao: o OnTick passa a chamar PrintMarketIntelligence() imediatamente depois de UpdateMarketContext(), com o gate EnableMarketIntelligence && !MQL_TESTER && AccountLogGatePodeImprimir('market_intel', 3600), ou seja uma foto por hora por CONTA - o mesmo portao dos outros retratos, para os 13 graficos nao escreverem a mesma foto e para o journal do Strategy Tester ficar intacto. Nenhum limite, regra de entrada ou de saida, lote, alvo, stop, spread, preco ou parametro de risco foi alterado: UpdateMarketContext, IsMarketOpenForTrading e GetIntelligenceLotFactor ficam exactamente iguais, muda apenas que o retrato que ja era calculado passa a ser publicado. " "v1.2.137 (04/11/2026) - P1.92: o backtest media um EA SEM IA. MEDIDO em Tester\\logs\\20261104.log (run das 18:08, XAUUSD H1, XAI_BASE_v131.ini): '[AI] FILE EM FALTA | Data\\prediction_XAUUSD.json' repetido durante toda a simulacao, embora o ficheiro existisse em MQL5\\Files\\Data com mtime 04/11 22:28. Dentro do Strategy Tester a sandbox e Tester\\Agent-<ip>-<porta>\\MQL5\\Files\\, onde o pipeline Python nao escreve, logo o portao de IA corria sempre sem previsao - o mesmo tipo de defeito que o P1.91 expos no ADX. Correcao: LoadAIPrediction passa a resolver o ficheiro tentando primeiro a raiz LOCAL e, se ausente, FILE_COMMON (que resolve para a pasta comum verdadeira tambem dentro do tester, medido na v1.2.45), e a linha [AI] LOAD passa a publicar ROOT=LOCAL ou ROOT=COMMON para a raiz deixar de ser invisivel. A ordem preserva a producao: onde o ficheiro local existe, nada muda. HG-01: #property version estava em '1.326', que pela formula minor*100+patch corresponde a v1.2.126 - oito versoes atras do EA_VERSION_STRING - e passa a '1.337'. Nenhum limite, regra de entrada ou de saida, lote, alvo, stop, spread, preco ou parametro de risco foi alterado: muda de onde sai um ficheiro de leitura. " "v1.2.136 (04/11/2026) - P1.91: o ADX nunca era lido no Strategy Tester, portanto TODO backtest media um EA diferente do que corre em producao. MEDIDO em Tester\\logs\\20261104.log (run das 18:08, XAUUSD H1, 2026.09.01..2026.11.01): '[ADX] INIT OK | Symbol=XAUUSD | Period=14' as 18:08:33 e, no mesmo segundo, '[ADX] SEM LEITURA | XAUUSD | BarsCalculated=-1 | tratado como neutro (fail-open)'; dez dias de simulacao depois o resumo do scanner publicava 'ADX(sem/ok)=2093/0' - zero leituras boas em 2093 tentativas. A causa e o guarda introduzido na v1.2.94: GetADX() devolvia -1.0 quando BarsCalculated < ADXPeriod*2, mas BarsCalculated devolve -1 justamente enquanto o MT5 nao calculou o indicador, e e o CopyBuffer que manda calcular - o guarda impedia o CopyBuffer, o handle nunca aquecia e o guarda nunca deixava de disparar (impasse auto-sustentado, invisivel porque saia como fail-open). Prova diferencial no mesmo run: GetATR() (Indicators/VolatilityFilter.mqh:61) le CopyBuffer directo sem essa guarda e devolve ATR%=0.39 normalmente. Correcao: o guarda passa a exigir calculadas > 0 - o -1 (sem dado calculado) tenta o CopyBuffer e o valor positivo pequeno (aquecimento real) continua a devolver -1.0 como antes; a mensagem de falha do CopyBuffer passa a publicar BarsCalculated. Efeito pratico: o cenario (MarketScenario), o gate dinamico de ADX, o DecisionEngine e o ValidationEngine deixam de correr em fail-open no tester, e os PF medidos ate hoje (0.6206) descrevem um EA sem ADX - nao valem como medida da producao e tem de ser re-medidos com este build. Nenhum limite, regra de entrada ou de saida, lote, alvo, stop, spread, preco ou parametro de risco foi alterado: muda a leitura de um indicador, que passa a existir onde antes estava sempre ausente. " "v1.2.135 (04/11/2026) - P2.20: o HEALTH MONITOR acusava pipeline parado quando o mercado FECHAVA, e a mesma mensagem dizia 0 falhas nos modulos que acusava. MEDIDO no journal as 18:07:23 de 04/11 (23:07 servidor), grafico USDBRL M5: 'HealthMonitor: modulo de pipeline parado | PYTHON/CSV/JSON | Segundos=741' com 'Segundos sem tick: 0' e 'Ticks/seg: 1' na MESMA mensagem, enquanto Files\\Data\\dataset.csv tinha a ultima barra em 2026.11.04 22:50:00 e mtime 18:00:01. Causa: UpdateDataset() devolve false enquanto iTime(...,0) nao muda, logo no fecho diario o progresso congela por desenho e o watchdog interpreta isso como modulo morto; os modulos de liveness (ATR/ADX/RSI/AI) ja tinham a guarda HealthSymbolSessionOpen desde a v1.2.80, o ramo de pipeline nao tinha. Correcoes, todas de monitorizacao: (1) o ramo de pipeline passa a devolver OK e a zerar g_wdProgressFails quando a sessao do simbolo esta fechada; (2) HealthMonitorSummary passa a ler g_wdProgressFails para os modulos de pipeline, que era o contador que o veredicto realmente usa - o resumo dizia 'Status: ERROR (check FALHOU)' e 'PYTHON: 0 falhas | CSV: 0 falhas | JSON: 0 falhas' na mesma linha; (3) as tres strings de journal que saiam com U+FFFD na origem (o ficheiro HealthMonitor.mqh tinha 28 caracteres corrompidos) passam a ASCII, pela mesma regra do P1.53. Nenhum limite, regra de entrada ou de saida, lote, alvo, stop, spread, preco ou parametro de risco foi alterado: muda o veredicto de saude quando a sessao esta fechada e o que a linha publica. " "v1.2.134 (04/11/2026) - P-01d: a porta do gateway passa a ser lida do .env. MEDIDO em 04/11/2026 com list_open_charts, com o terminal em producao: as 13 janelas do perfil XAI_P216_LIVE, todas com XAU_AI_PRO anexado, estao guardadas com AIGatewayUrl em 127.0.0.1:9001 - o servidor MCP EMBUTIDO do MT5, como o P-01b provou - e com AIGatewayToken igual ao NOME da variavel do .env, 17 caracteres. O MT5 guarda as ENTRADAS com que o grafico foi anexado e elas sobrevivem a mudar a omissao do codigo, portanto a correcao do P-01b (omissao 9001 para 9011) nao alcancava nenhuma das 13 janelas. Em vez de reescrever 13 graficos com o risco de perder as entradas afinadas, o .env passa a ser a unica fonte do ENDERECO, exactamente como ja era do token: se XAU_GATEWAY_PORT existir e for so digitos, a porta da entrada e substituida em AIGatewayUrlEfetiva(); sem a chave, a URL fica como esta. Nenhum limite, regra de entrada ou de saida, lote, alvo, stop, spread, preco ou parametro de risco foi alterado: muda de onde sai a porta de uma leitura. " "v1.2.133 (04/11/2026) - P-01b/P-01c: o gateway de IA estava no ar e o EA falava com o servidor ERRADO, com um token de outro tamanho. MEDIDO em 04/11/2026 com o gateway a correr: GET autenticado em 127.0.0.1:9011/api/ai/predict devolve 200 usando o XAU_GATEWAY_TOKEN de 64 caracteres do .env, enquanto 127.0.0.1:9001 - a omissao de AIGatewayUrl - devolve 401 a qualquer rota porque e o servidor MCP EMBUTIDO do MT5 (config\\assistant.ini), e os graficos levavam 17 caracteres em AIGatewayToken. O 401 repetido no journal desde 03/11 era endereco errado lido como credencial recusada. Duas correcoes, ambas de configuracao e credencial, nenhuma de risco: (1) AIGatewayUrl passa a 9011 por omissao; (2) nasce AIGatewayTokenEfetivo(), que usa o input quando tem 32 ou mais caracteres e senao le XAU_GATEWAY_TOKEN do .env na sandbox (sem FILE_COMMON, a mesma raiz que o modulo ja usa para a previsao), com o NUMERO de caracteres enviados a continuar a ser o unico dado publicado - o valor nunca vai para o journal. Nenhum limite, regra de entrada ou de saida, lote, alvo, stop, spread, preco ou parametro de risco foi alterado. BLOQUEIO QUE CONTINUA, medido na mesma chamada: a inferencia responde ok=true com available=false e reason='erro na inferencia: X has 25 features, but HistGradientBoostingClassifier is expecting 30 features as input' - o artefacto carregado e de 30 features e o runtime monta 25 (25F-v2), portanto o filtro de IA ainda nao produz sinal nenhum ate o modelo publicado e o contrato de features voltarem a coincidir. " 
                         "v1.2.132 (04/11/2026) - P-01: o EA chamava o gateway de IA com POST numa rota que o servidor declara como GET. MEDIDO em 04/11/2026: `127.0.0.1:9001`, o endereco por omissao de AIGatewayUrl, e o MCP EMBUTIDO do MT5 (config\\assistant.ini: [MCP.MetaTrader] Endpoint=http://127.0.0.1:9001/mcp, escutado pelo terminal64), nao o gateway - o 401 lido em 03/11 veio do terminal e foi interpretado como credencial recusada; o gateway usa 9011 (XAU_GATEWAY_PORT) e nao estava no ar. Mesmo com porta e token certos, backend\\fastapi_gateway.py declara @app.get(\"/api/ai/predict\") e o EA enviava POST: o middleware de auth corre antes do routing, por isso o sintoma era 401 e o 405 ficava escondido. A chamada passa a GET com corpo vazio, mantendo `Authorization: Bearer <AIGatewayToken>` e os parametros symbol/timeframe na query string. O resultado do WebRequest deixa de escrever por cima do cabecalho de ENTRADA (result_headers dedicado). Nenhum limite, regra de entrada ou de saida, lote, alvo, stop, spread, preco ou parametro de risco foi alterado: muda o verbo HTTP de uma leitura e o buffer que recebe os cabecalhos da resposta. " "v1.2.131 (03/11/2026) - P2.22: a base de dados escrevia uma linha de erro de runtime em cada um dos 15 graficos e apontava para uma pasta onde o terminal nao escreve. MEDIDO no journal as 23:37:07 e repetido em todos os reloads ate 23:49:43: 15 linhas [DATABASE] sqlite3 indisponivel (compilado sem DLL): base de dados desativada, uma por grafico, e a linha [DATABASE] DB: C:\\Program Files\\MetaTrader 5\\MQL5\\Experts\\XAU_AI_PRO\\Enterprise\\Data\\xau_ai_pro.db | Connected: No. O build sem sqlite3 e a decisao por omissao do P1.58, tomada para o EA carregar em qualquer terminal sem permissao de DLL, e nao um defeito de runtime - a mensagem passa a dizer DESATIVADA | build sem sqlite3 (macro XAI_USE_SQLITE_DLL nao definida) | nao e erro, sai 1x por sessao e por CONTA (LogSessaoPodeImprimir) e nomeia o caminho que seria usado. Segundo defeito do mesmo bloco: a raiz do caminho era TerminalInfoString(TERMINAL_PATH), a pasta de INSTALACAO (C:\\Program Files\\MetaTrader 5), onde o terminal nao escreve; passa a TerminalInfoString(TERMINAL_DATA_PATH), a pasta de dados. Terceiro ponto do mesmo ciclo, de volume: o [VALIDATION] N BLOCKED saia uma vez por grafico em cada reload (medido as 23:49:43, 15 linhas com o mesmo texto) e passa a exigir a janela por CONTA, porque e resultado de init e nao muda entre instancias. EnableDatabase continua false por input, Connect() continua a devolver false sem DLL e nenhuma regra de entrada ou de saida, lote, alvo, stop, spread, preco ou parametro de risco foi alterado: muda o texto, a raiz de um caminho que so aparece em log e quantas vezes a linha sai. v1.2.130 (03/11/2026) - P2.21: o aviso de gateway com HTTP de erro inundava o journal. MEDIDO as 23:41-23:42 com 13 graficos: uma linha [AI] GATEWAY por simbolo por minuto, ~780 linhas/hora, todas descrevendo o MESMO 401 de configuracao. A janela era de 60 s por PROGRAMA, entao cada grafico tinha a sua e o gate nunca agregava nada. Agora a janela e por CONTA (AccountLogGatePodeImprimir, arquivo em Common) com 1 linha por tag+status a cada 30 min, e a janela local subiu para 300 s. A informacao nao muda de minuto para minuto, logo a decisao de sinal nao muda - so o volume de log. Alem do texto, tres recusas 401/403 seguidas armam um cooldown de 1800 s no gateway, porque credencial recusada nao se cura durante a sessao, e um HTTP 200 zera o contador: nesse periodo a funcao devolve false sem round-trip e o EA usa o ficheiro local de previsao, exactamente como ja fazia. v1.2.129 (03/11/2026) - P2.20: a mensagem de erro do gateway culpava o token sem evidencia. MEDIDO no journal as 23:38:11: '[AI] GATEWAY | HTTP 401 | ... | 401/403 = token ausente ou invalido (AIGatewayToken)' era texto FIXO - saia igual para token vazio, token recusado, 404 de rota e 5xx de backend, e ainda repetia a lista de hipoteses em cada linha. Agora o motivo e classificado por evidencia: 401/403 com AIGatewayToken vazio vira 'token AUSENTE'; com token preenchido vira 'token RECUSADO (N caracteres enviados)' sem nunca imprimir o valor; 404 aponta AIGatewayUrl/rota; 422 aponta parametros; 5xx aponta backend. A mesma linha passou a declarar 'WebRequest=LIGADO (a chamada SAIU)' e o tamanho do corpo, que e a prova de que o defeito nao e a allowlist. Na falha de transporte (-1), 4014 deixou de ser publicado como 'WebRequest desabilitado': tem DUAS causas (URL fora da lista ou checkbox desligado) e o texto agora diz as duas, com 4060/5200/5202 separados. Mesma correcao de raiz do P2.19, agora no EA. v1.2.128 (03/11/2026) - P2.19: o diagnostico de WebRequest mandava o operador ao lugar errado. MEDIDO neste terminal as 23:18:44 e reconfirmado as 23:36:13: http://127.0.0.1:9001/api/ai/predict PASSOU a lista (HTTP=401, portanto a chamada saiu) e as outras 5 URLs devolveram 4014, que o Scripts/XAI_WebRequestCheck.mq5 traduzia como WebRequest DESABILITADO em Opcoes > Expert Advisors. As duas leituras nao podem ser verdadeiras ao mesmo tempo: se uma URL passou, o checkbox esta ligado, e o 4014 das restantes significa URL fora da lista. A mensagem errada mandava o operador conferir um controle que ja estava certo e escondia o defeito real. Correcao, so de diagnostico: o 4014 passa a ser descrito como NAO PERMITIDO (URL fora da lista, ou checkbox desligado), o script acumula as URLs bloqueadas por 4014/4060 e o fim imprime um VEREDITO que separa as duas causas por EVIDENCIA - basta UMA URL passar para provar checkbox ligado - mais uma linha ACAO com a lista exacta a adicionar em Allow WebRequest for listed URL. Provado em runtime as 23:36:13.798: VEREDITO | WebRequest esta LIGADO (1 URL(s) passaram a lista) | o defeito e a LISTA, nao o checkbox. Nenhuma regra de entrada ou de saida, lote, alvo, stop, spread, preco ou parametro de risco foi alterado: muda apenas o texto de journal de um script de diagnostico. v1.2.127 (03/11/2026) - P2.18: o [CENARIO] publicava o SENTINELA como se fosse medicao. MEDIDO no journal do expert as 22:32:56.730 de 03/11: [CENARIO] EURUSD | TENDENCIA_FRACA | ADX=20.6 | ATR%=-1.00 | tendencia=RANGING | lote x0.90 | alvo x1.00. O -1.00 nao e volatilidade, e o valor que MarketVolatilityPercent() devolve quando nao conseguiu ler o ATR (atr<=0 ou preco<=0), e GetADX() devolve <=0 na mesma situacao; a DETECAO sempre tratou esses valores como ausencia de leitura (volPct>0.0 e adx<=0 em MarketScenarioDetect), mas as duas funcoes que ESCREVEM a linha - o [CENARIO] por simbolo e o [CENARIO] RETRATO - imprimiam o valor cru. Correcao: nascem ScenarioADXStr() e ScenarioAtrPctStr() em Filters/MarketScenario.mqh, que traduzem o sentinela para a palavra sem leitura, e os quatro pontos de impressao (2 no retrato, 2 na linha por simbolo) passam a usar os helpers. Deteccao, ScenarioLotFactor, ScenarioTargetFactor e a leitura dos indicadores ficam exactamente iguais. Nenhuma regra de entrada ou de saida, lote, alvo, stop, spread, preco ou parametro de risco foi alterado: muda apenas o texto de uma linha de journal que antes podia ser lida como medida. v1.2.127 (03/11/2026) - P2.17: o erro 4022 do CopyBuffer dizia falha e era aquecimento. MEDIDO no journal do expert as 21:54:03 de 03/11, com 15 graficos: [SIGNAL] SEM LEITURA | GBPUSD | falha ao copiar EMA Fast | Error=4022 repetido uma vez por grafico, quando 4022 (ERR_INDICATOR_DATA_NOT_FOUND) significa que o MT5 ainda nao calculou o indicador depois do reload e nao que o dado falte. Correcao, so de diagnostico: os tres blocos CopyBuffer<=0 do sinal (EMA Fast, EMA Slow, RSI) passam a ler GetLastError() e BarsCalculated() e a distinguir EMA Fast em aquecimento (MT5 calcula apos reload) de falha ao copiar EMA Fast, publicando BarsCalc, Error e o aviso de 1 linha por hora por conta e simbolo. A classificacao do sinal devolve 1/-1 exactamente nas mesmas condicoes de antes. Nenhuma regra de entrada ou de saida, lote, alvo, stop, spread, preco ou parametro de risco foi alterado. v1.2.126 (03/11/2026) - P2.16: o token do servidor MCP embutido estava escrito em Core/Config.mqh, portanto publico no GitHub, e o servidor arrancava com ele nos 15 graficos (medido: [MCP] servidor ativo | metodos=7/7 risk=ok ai=ok health=ok account=ok positions=ok ... as 21:44:59). Correcao sem tocar em trading: EnableMCPServer passa a falso por omissao, MCPServerToken passa a vazio no codigo (token privado vai no input do grafico) e o valor antigo e recusado em runtime, com uma linha por conta por hora. Nenhuma regra de entrada ou saida, lote, alvo, stop, spread ou preco foi alterada. " +
                            "v1.2.125 (03/11/2026) - P2.15: o mesmo veto de validacao saia uma vez por GRAFICO. MEDIDO no journal do expert, so impressao: [VALIDATION] BLOCK | TREND SELL | <simbolo> | contramao vetada | ADX indisponivel apareceu 23 vezes na sessao, sempre o mesmo texto para o mesmo par simbolo+motivo, porque a janela de 5 min de ValidationLogAllowed e por INSTANCIA (comentario de v1.2.16) e o terminal tem 15 graficos. Correcao: o corpo antigo virou ValidationLogAllowedLocal e ValidationLogAllowed passou a exigir tambem o portao por CONTA (Monitoring/AccountLogGate.mqh) com a mesma janela de 5 min, com a tag saneada para nome de ficheiro. O g_validationLastBlock continua a ser escrito antes de qualquer filtro, no tester nao ha portao e nenhuma validacao, limite ou regra de entrada mudou - so a repeticao da linha no journal. " + "v1.2.124 (03/11/2026) - P2.14: a rajada de [STOP] do reload ainda passava uma vez, na estreia do portao. MEDIDO no journal do expert, so impressao: o reload de 21:29:47 (o primeiro com o P2.13) deixou 15 linhas [STOP] com o MESMO motivo=2 e a MESMA equity=12592.02, e o reload seguinte, as 21:32:13, deixou 1 - a diferenca nao era a correcao, era o ficheiro do portao ja existir. Causa: AccountLogGatePodeImprimir le o carimbo, compara e escreve sem bloqueio, e no primeiro uso as 15 instancias leem nunca impresso ao mesmo tempo. Correcao: no motivo REASON_RECOMPILE, que e o unico simultaneo, a linha sai so da dona do pipeline (ChartID()==PipelineMasterChart()), eleicao ja existente e unica por conta; os outros motivos continuam no portao 1x/120 s. Sem dona publicada o portao decide como antes, e no tester nada muda. Nenhuma transicao de estado, contador, lote, alvo, stop, spread, preco, regra de entrada ou de saida foi alterado. " + "v1.2.123 (03/11/2026) - P2.13: tres linhas de journal repetiam o MESMO facto uma vez por grafico, e uma delas custava um FileOpen por tick. MEDIDO no journal do expert (filtro por programa, 15 instancias) nesta sessao: (a) cada reload deixa 15 linhas [STOP] no mesmo segundo - 21:15:11, 21:19:10 e 21:26:23 de 03/11, todas com motivo=2 e a MESMA equity (12583.02, 12589.19 e 12592.02); (b) a primeira observacao de um simbolo por instancia imprimia [STATE] USDCAD | -> MANAGING sem filtro nenhum, e entre 21:15:14 e 21:15:19 sairam 11 linhas iguais em 5 segundos, uma por grafico, para a MESMA posicao e o MESMO estado; (c) o [PIPELINE] STANDBY avancava o carimbo SO quando a linha saia, portanto enquanto o portao por conta respondia que outra instancia ja tinha escrito, a condicao ficava verdadeira para sempre e o FileOpen do portao corria a cada tick nas 14 instancias em espera. Correcao, so de impressao e de IO de log: (a) o [STOP] passa a 1 linha por conta e por motivo numa janela de 120 s, e um motivo NOVO continua a sair na hora; (b) a primeira observacao de um simbolo passa a 1 linha por conta e por simbolo por hora, com a transicao REAL intacta e sem filtro - o ramo que ja imprimia sempre para estado >= EXECUTION_READY continua exactamente igual; (c) o carimbo do STANDBY passa a avancar em toda a tentativa, logo o portao e consultado no maximo 1x por hora por instancia em vez de a cada tick. No tester nada muda: nao ha portao e as linhas saem como antes. Contas: a rajada do reload cai de 15 linhas [STOP] para 1 e o [STATE] de 11 para 1 por hora por simbolo. Nenhuma transicao de estado, contador, lote, alvo, stop, spread, preco, regra de entrada ou de saida foi alterado. " + "v1.2.122 (03/11/2026) - P2.12: a linha que registava o resultado de um trade dizia o simbolo ERRADO. MEDIDO no journal do terminal as 20:50:33 de 03/11, no fecho de uma posicao USDCHF de +10.00 USD: a linha saiu como 2026.11.04 01:50:33 | [TRADE] | USDCOP | Statistics trade registrado | WIN | 10.00, e a MESMA linha saiu com USDCLP no mesmo instante. A causa e o prefixo do Logger, que e sempre _Symbol - o simbolo do GRAFICO - e nao o simbolo NEGOCIADO; com 15 graficos o mesmo fecho ganhava 15 nomes e o journal passava a atribuir lucros a simbolos que nao os tiveram. Correcao: StatisticsRegisterTrade passa a receber o simbolo negociado e o ticket do deal (lidos no OnTradeTransaction a partir do proprio deal) e a linha publica negociado=<simbolo> | deal=<ticket>. O aprendizado por simbolo ([AI MEMORY], WR/MEM/BOOST) nunca esteve em causa, porque le sempre do deal. Este ciclo nao altera contadores, win rate, streaks, lote, alvo, stop, spread, preco, regra de entrada ou de saida. " + "v1.2.121 (03/11/2026) - P2.09: O EA NAO COMPILAVA desde o bloco de SQLite da v1.2.116, e o erro estava a vista ha varios ciclos. MEDIDO agora com o compilador a apontar para o EA - e nao para o script de sonda, que era o alvo por omissao da ferramenta e por isso os ciclos anteriores reportavam 0 erros: 22 erros, todos com uma unica causa raiz. Monitoring/TradeLoggerSQLite.mqh faz include de Database.mqh, ficheiro que NAO existe no MQL5 nem no projecto, e o compilador responde file Database.mqh not found na linha 10 do header; como o include falha, o resto do ficheiro fica por declarar e o EA recebe undeclared identifier para STradeRecord, TradeLoggerSQLiteInit, TradeLoggerSQLiteLog e TradeLoggerSQLiteShutdown nas linhas 1867 a 1891. Correcao: o modulo inteiro passa a estar atras da macro XAI_USE_TRADELOG_SQLITE, DESLIGADA por omissao, com o include e o bloco de chamada protegidos pela mesma macro - o mesmo padrao que o P1.58 usou para o sqlite3.dll, para o EA carregar em qualquer terminal sem dependencia externa. O codigo fica preservado no ficheiro e liga-se fornecendo o Database.mqh e definindo a macro. Nenhum registo se perde: o LogTradeCSV, que sempre foi o caminho real de gravacao de trades, continua exactamente igual, e era o unico que alguma vez correu. Fica tambem registada a licao de medicao: a ferramenta de compilacao tinha XAI_LogGateProbe.mq5 como fonte por omissao e compilar sem indicar o EA dava 0 erros sobre um ficheiro que nao e o EA. Nenhuma ordem, limite, regra de entrada ou de saida, lote, spread, alvo, precificacao ou parametro de risco foi alterado. " + "v1.2.120 (03/11/2026) - P2.08: pedido do dono - ligar o servidor MCP com token. MEDIDO por leitura de codigo antes de mexer: os inputs estavam EnableMCPServer=false e MCPServerToken vazio, e o CMCPServer::Init ja desligava o servidor com token curto e dizia por que, logo o que faltava era um token com os 8 caracteres minimos e o interruptor ligado. Faltava tambem prova de que a API responde: a unica linha existente dizia servidor inicializado e nunca chamava um metodo, portanto nao distinguia API viva de API morta. Correcao: EnableMCPServer passa a true e MCPServerToken passa a um token local de 18 caracteres, e nasce o CMCPServer::SelfTest, que corre os SETE metodos de LEITURA - risk.status, ai.signal, health.status, account.info, positions.open, checklist.status e gate.verdict - e publica a contagem e o estado de cada um numa unica linha [MCP] servidor ativo, no maximo 1x por hora por conta. O ramo de falha deixou de escrever sem filtro e passa a dizer o numero de caracteres lidos e o minimo exigido, para o proximo erro ser medivel sem leitura de codigo. Nenhuma ordem, limite, regra de entrada ou de saida, lote, spread, alvo, precificacao ou parametro de risco foi alterado: o servidor MCP so le estado e o trade.validate continua a validar sem enviar. Fica medido e registado como pendencia que o EA nao abre socket e que nenhum caminho do EA chama MCPHandleRequest, logo o token protege uma API in-process e nao um porto de rede. " + "v1.2.119 (03/11/2026) - P2.07: primeiro ciclo medido com a v1.2.118 em producao nos 15 graficos. MEDIDO no MQL5/Logs/20261103.log na janela estavel 08:09:40 a 08:41:06 (31,4 min, 90 linhas, 2,9 linhas/min, zero linhas sem tag) contra a baseline de 7,3 linhas/min da v1.2.116: o [CENARIO] caiu de 11 linhas de rajada para UMA unica linha RETRATO as 08:10:45 com os 10 simbolos e os seus factores, o [BACKUP] deixou de repetir o resumo do gestor e o numero de snapshots removidos passou a uma linha so (snapshots antigos removidos=9), e o [PIPELINE] STANDBY caiu de 7 linhas em 5,5 min para 1 em 31 min, com zero linhas [DIAG] LOGGATE - prova de que a partilha de ficheiro do P2.05 resolveu a abertura recusada. Sobrou o [SCANNER] com 25 das 90 linhas, e as rajadas eram TODAS do heartbeat de 30 min: as 08:39:44 seis simbolos com o MESMO desfecho normal (NoSignal, Stale) escreveram em fila no mesmo ciclo. Correcao: os baldes NORMAIS (CanOpen, JaNegociado, Cooldown, Stale, NoSignal, DirHist) deixam de ter heartbeat por simbolo e saem apenas quando o desfecho MUDA, que e quando ha informacao; o [SCANNER] RESUMO continua a publicar a contagem por balde de cada janela, logo nada se perde. So AllowTrade e ExecFail mantem heartbeat de 30 min, porque um deles parado ha meia hora significa que o EA tentou entrar e nao conseguiu. Segundo defeito corrigido no mesmo bloco, de FIDELIDADE e nao de volume: o memo do desfecho era actualizado ANTES do portao por conta, portanto uma mudanca abafada pela janela de 30 min nunca mais era tentada e o simbolo ficava invisivel ate voltar a mudar; passou a avancar so depois do portao. Contas: o [SCANNER] BLOCK cai de cerca de 1 100 linhas por dia para apenas as mudancas reais. Nenhum limite, regra de entrada ou de saida, lote, spread, alvo, precificacao ou parametro de risco foi alterado: muda apenas o que, e quantas vezes, vai para o journal. " + "v1.2.118 (03/11/2026) - P2.06: o [CENARIO] era o maior emissor da janela estavel e a maior parte nao era mudanca de estado, era o retrato inicial. MEDIDO em MQL5/Logs/20261103.log na janela 07:30:57 a 07:36:26 com a v1.2.116: [CENARIO] 11 linhas escritas entre 07:31:00.438 e 07:31:04.816, todas no master USDCNH, para a MESMA foto de mercado de 11 simbolos, e 236 linhas no dia. Causa: em cada reload o cache da instancia esta vazio, os 11 simbolos aparecem como MUDOU e o P2.04 ja so conseguia limitar a 1 por hora por simbolo - o que ainda sao 11 linhas de rajada sempre que a hora vence. Correcao: a PRIMEIRA observacao de cada simbolo passa a ser acumulada em memoria e publicada como UMA unica linha [CENARIO] RETRATO no fim do ciclo (ScenarioSnapFlush, chamada pelo scanner), com janela de 1 hora por CONTA; o cache fica actualizado no momento da observacao, logo a proxima mudanca REAL de classe, regime, factor de lote ou factor de alvo continua a sair na hora, por simbolo, e sem filtro, e o heartbeat por simbolo nao muda. Contas: a rajada do reload cai de 11 linhas para 1 e o [CENARIO] de cerca de 236 linhas por dia para cerca de 30, sem perder nenhuma mudanca de cenario. Foi tambem autorizada e executada a limpeza das copias antigas dentro de Experts/XAU_AI_PRO (109 ficheiros .pre_pNNN, .bak_before_pNNN, .bak e .orig, 2,9 MB) que nao eram compiladas mas inflavam todos os censos. Nenhum limite, regra de entrada ou de saida, lote, spread, alvo, precificacao ou parametro de risco foi alterado: muda apenas o que, e quantas vezes, vai para o journal. " + "v1.2.117 (03/11/2026) - P2.05: o ciclo anterior cortou GLOBAL e AI e a janela estavel seguinte mostrou os dois emissores que sobraram, ambos de ESTADO e nao de decisao. MEDIDO no MQL5/Logs/20261103.log na janela estavel 07:30:57 a 07:36:26 (5,5 min, 40 linhas, 7,3 linhas/min, zero linhas sem tag): [CENARIO] 11, [BACKUP] 9, [PIPELINE] 9, [VALIDATION] 3, [SCANNER] 2, [RESUMO] 2, [SESSION] 1, [SIGNAL] 1, [DATA] 1, [STATE] 1, com [AI] 0 e [GLOBAL] 0 contra 27 e 30 da baseline 07:00 a 07:15. Tres correcoes, todas de impressao. (1) BACKUP: o CBackupManager imprimia uma linha por snapshot removido - 7 linhas seguidas as 07:31:28 - e o EA escrevia de novo o resumo que o proprio BackupManager ja tinha escrito (copiados=99 falhas=0), logo cada backup gastava 9 linhas para dizer uma coisa; o detalhe por ficheiro passa a uma unica linha com a contagem e o resumo duplicado do EA deixa de sair, porque o BackupManager ja o publica nas duas ramificacoes, sucesso e problema. (2) LOG GATE: na mesma janela o [PIPELINE] STANDBY saiu 7 vezes, uma por grafico, apesar de a janela ser de 3600 s por CONTA; o ficheiro Common/Files/XAU_AI_PRO/loggate_pipe_standby.bin ficou com data de 07:25:50 e nunca mais foi escrito, o que so acontece quando o FileOpen devolve INVALID_HANDLE e o gate cai no fail-open. Os 15 graficos correm em threads diferentes no mesmo terminal e abrem o MESMO ficheiro sem partilha declarada; o FileOpen passa a pedir FILE_SHARE_READ e FILE_SHARE_WRITE, que e a explicacao provavel desta abertura recusada. (3) O fail-open continua a ser a regra - erro de log nunca esconde informacao - mas deixa de ser invisivel: quando o ficheiro falha sai no maximo 1 linha [DIAG] LOGGATE falhou por hora por instancia, com a tag, a janela e o codigo do erro, para a proxima janela poder provar se o throttle voltou a funcionar. Nenhum limite, regra de entrada ou de saida, lote, spread, alvo, precificacao ou parametro de risco foi alterado: muda apenas o que, e quantas vezes, vai para o journal. " + "v1.2.116 (03/11/2026) - P2.04: a v1.2.115 entrou em producao nos 15 graficos e a janela de recarga mostrou o proximo emissor a corrigir. MEDIDO no MQL5/Logs/20261103.log, janela POS 07:25:46 a 07:28:19 (2,6 min, 205 linhas, ainda a recarregar): [CENARIO] 31 a mais cara da janela, [SCANNER] 26, [PIPELINE] 14, [SIGNAL] 12, [GLOBAL] 10, [VALIDATION] 6, [AI] 1 contra 27 no intervalo 07:00-07:15 da v1.2.111. O [CENARIO] nao vinha do heartbeat: em cada reload o cache da instancia esta vazio, todos os 11 simbolos do scanner aparecem como MUDOU e os 15 graficos republicam a mesma foto. Uma primeira observacao nao e mudanca de estado, logo passa a usar gate por CONTA e por simbolo (cenario_cfg_, 3600 s); o cache e actualizado antes de sair, de forma que a proxima mudanca REAL de classe, regime, factor de lote ou factor de alvo sai na hora, sem filtro. Contas: o bloco de [CENARIO] no arranque cai de 11 simbolos por grafico para 11 por hora por conta. Nenhum limite, regra de entrada ou de saida, lote, spread, alvo, precificacao ou parametro de risco foi alterado: muda apenas quando a mesma foto inicial vai para o journal. " + "v1.2.115 (03/11/2026) - P2.03: o [AI] era a familia mais cara do dia e a fatia maior nao era informacao nova, era a mesma causa repetida por simbolo. MEDIDO no MQL5/Logs/20261103.log as 07:18, com a v1.2.111 ainda a correr nos 15 graficos: 7 944 linhas no dia, [AI] 951, e nas ultimas 150 linhas [GLOBAL] 40, [SIGNAL] 26, [AI] 24. O aviso [AI] PREDICAO VENCIDA usava a chave ai_stale_ mais o simbolo, com janela de 3 600 s, o que dava um maximo de 15 linhas por hora (uma por simbolo) enquanto o AIGateway esta parado e a IA fica SEM PRECO. A causa e uma so para a conta e a linha ja nomeia o simbolo, logo a chave passa a ser da CONTA (ai_stale, 3 600 s): o mesmo aviso, com o mesmo texto e o mesmo simbolo, mas no maximo 1 por hora em vez de 15. Contas: o [AI] PREDICAO VENCIDA cai de ate 15 por hora para 1 por hora, ou seja de cerca de 360 linhas por dia para 24. Nenhum limite, regra de entrada ou de saida, lote, spread, alvo, precificacao ou parametro de risco foi alterado: o codigo de deteccao de predicao velha, o ResetAIState e o bloqueio de execucao continuam exactamente iguais, muda apenas quantas vezes o mesmo aviso vai para o journal. " + "v1.2.114 (03/11/2026) - P2.02: o P2.01 cortou GLOBAL, SIGNAL BUY/SELL e o RESUMO do scanner, mas a cauda do journal continuava a repetir dois retratos. MEDIDO no MQL5/Logs/20261103.log as 07:15, com a v1.2.111 ainda a correr nos 15 graficos: 7 916 linhas no dia, [SIGNAL] 340, [CENARIO] 234, e nas ultimas 150 linhas SIGNAL 24 e CENARIO 14 - as duas familiares mais caras a seguir ao [AI] e ao [GLOBAL]. Duas correcoes, ambas de impressao: (1) o [SIGNAL] NEUTRO saia 1x/15 min por simbolo em CADA grafico, com a mesma tendencia, as mesmas EMA50/EMA200 e o mesmo RSI nos 15 graficos; passa a 1x/hora por simbolo e por CONTA (sig_neu_, 3600 s por CONTA). (2) o [CENARIO] tinha um heartbeat de 900 s por INSTANCIA que so servia para provar que o EA estava vivo; passa a 1x/hora por CONTA e por simbolo (cenario_hb_, 3600 s por CONTA), mas a linha que MUDA - classe, regime, factor de lote e factor de alvo - continua a sair na hora, sem filtro, exactamente como antes. Contas: o [SIGNAL] NEUTRO cai de 11 simbolos por ciclo para 11 por hora no maximo e o [CENARIO] heartbeat cai de 11 por ciclo para 11 por hora no maximo, ou seja as duas familias deixam de acompanhar o ciclo de 5 minutos. Nenhum limite, regra de entrada ou de saida, lote, spread, alvo, precificacao ou parametro de risco foi alterado: muda apenas o que, e quantas vezes, vai para o journal. " + "v1.2.113 (03/11/2026) - P2.01: o P2.00 cortou o volume por ciclo e o journal ficou legivel, mas a janela seguinte mostrou as fontes que ainda escreviam a MESMA linha varias vezes. MEDIDO no ficheiro MQL5/Logs/20261103.log as 07:07, com a v1.2.112 ja a correr: 7 832 linhas no dia e, nos 2 minutos depois do reload (07:05:20 em diante), apenas 4 linhas - a reducao e real e nenhuma linha de DECISAO foi perdida. Essas 4 linhas eram exactamente o problema que sobrava: o [SIGNAL] SELL em USDCNH, com RSI 74.26, saiu 4 vezes entre as 07:03 e as 07:06 com o MESMO RSI, o [SCANNER] RESUMO saiu a cada 30 segundos, o [STATUS] sai 1x/30 min por instancia e o [GLOBAL] continuava a sair 11 vezes por ciclo (uma por simbolo, de 5 em 5 minutos, em cada um dos 15 graficos). Quatro correcoes, todas de impressao: (1) o [SIGNAL] BUY/SELL passa a sair quando a DIRECAO muda e, no maximo, 1x/hora por CONTA e por simbolo - a classificacao nao muda (o return continua a ser 1/-1 exactamente nas mesmas condicoes), muda so quando a linha e escrita; (2) o [SCANNER] RESUMO passa a exigir tambem a janela por CONTA de 15 minutos quando ha sinal ou trade, porque o retrato era o do ciclo anterior; os contadores ADX(sem/ok) e SIG(sem/neutro) so avancam quando a linha sai, para o delta publicado continuar a ser o do intervalo realmente impresso; (3) o [GLOBAL] passa de 5 minutos por instancia para 1x/hora por CONTA e por simbolo - classe, sessao, factor de lote e exposicao mudam devagar e sao iguais nos 15 graficos; (4) a linha de CONTEXTO do spread ([VALIDATION] com o spread lido e o maximo permitido) passa a 1x/hora por CONTA e por simbolo, mantendo intacto o veto real [VALIDATION] BLOCK por SPREAD. Contas: o [GLOBAL] cai de cerca de 3 000 linhas por dia para 11 por hora no maximo, o [SIGNAL] deixa de repetir o mesmo sinal e o RESUMO deixa de sair a cada ciclo. Nenhum limite, regra de entrada ou de saida, lote, spread, alvo, precificacao ou parametro de risco foi alterado: muda apenas o que, e quantas vezes, vai para o journal. " + "v1.2.112 (03/11/2026) - P2.00: MEDIDO no journal do dia (pasta MQL5 Logs, 20261103.log) com a v1.2.111 ja a correr - 7 803 linhas as 07:01 - e a janela de 4 minutos depois do ultimo reload mostrou onde o volume ainda nascia: [PIPELINE] STANDBY 150 linhas no dia, [AI] LOAD 344, [PIPELINE] PROCESSANDO 176, [SCANNER] START 176, [SCANNER] POSITION CHECK OK 172, [AI] PREDICAO VENCIDA 129, [SYMS] AVISO 108. Os numeros sao contados no ficheiro, nao estimados. Cinco correcoes, todas de impressao: (1) o [PIPELINE] STANDBY usava um static POR INSTANCIA, logo 13 graficos em espera davam 13 linhas por hora a dizer o mesmo; passa a exigir tambem a janela por CONTA (pipe_standby, 1/hora). (2) O [PIPELINE] PROCESSANDO saia uma vez por simbolo em cada ciclo (11 linhas) e passa a 1 por CONTA e por hora. (3) O [SCANNER] POSITION CHECK OK foi REMOVIDA: dizia apenas que o simbolo ainda nao tinha sido bloqueado, e o desfecho real ja sai com simbolo e motivo em [SCANNER] BLOCK / [CENARIO] / [SIGNAL]; o [SCANNER] START passa a 1x/hora por CONTA e por simbolo. (4) O [AI] PREDICAO VENCIDA passa a 1x/hora por CONTA e por simbolo, porque as idades diferiam mas o facto era o mesmo, e o [AI] LOAD passa de 1x/hora para 1x/dia por CONTA e por simbolo, porque o caminho do ficheiro nao muda entre leituras. (5) O [SYMS] AVISO P1.19 e configuracao estatica e passa a 1x/dia por CONTA, e o [NOTIFY] SendNotification falhou passa a 1x/6h por CONTA e por codigo, com GetLastError() lido uma unica vez. Contas de hoje: cerca de 700 linhas por dia a menos e nenhuma linha de DECISAO perdida - todas as linhas cortadas eram estado ou configuracao repetida. Nenhum limite, regra de entrada ou de saida, lote, spread, alvo, precificacao ou parametro de risco foi alterado: muda apenas o que, e quantas vezes, vai para o journal. " + "v1.2.111 (03/11/2026) - P1.99: o journal de 03/11 (7 224 linhas ate 06:50) tinha 347 linhas sem tag, e duas dessas linhas eram defeito, nao estilo. (1) Monitoring/ValidationChecklist.mqh: o else estava pendurado no if INTERNO (LogInicioDetalhe) e nao no if(g_validationPassed). MEDIDO: 316 linhas [VALIDATION] no dia, e 13 de cada 14 instancias escreviam 0 BLOCKED (diagnostico de init, nao impede execucao) com ZERO bloqueios - um erro com nome de erro para dizer que estava tudo bem. As chavetas devolvem o else ao if exterior: SEM BLOCKED quando passa (1x por conta) e a contagem real quando bloquear. (2) Monitoring/Diagnostics.mqh: o detalhe multi-linha era colapsado com StringReplace sobre a barra invertida + n, mas em MQL5 essa sequencia e barra invertida literal e nao quebra de linha, logo a troca nunca casava e o detalhe saia como 9 linhas SEM TAG por arranque (Python, JSON, CSV, Permissoes, Conta, Simbolo, IA, Arquivos, Indicadores e Sistema: 225 no dia). Passa a usar as quebras reais (CR LF, LF e CR) e a cortar em 300 caracteres. (3) O unico mojibake que chegava ao journal - [DATA] | Indicadores invalid... com 176 linhas iguais - passa a ASCII [DATA] SEM LEITURA e a sair 1x/1h por CONTA e por simbolo; as outras 7 strings do DataLogger com o mesmo defeito de codificacao (codigo, OHLC, simbolo e arquivo) tambem ficam ASCII, para o journal nao voltar a mostrar caracteres partidos. (4) Quatro familias de linhas que ainda nao tinham tag passam a ter: EXECUTION: BLOQUEADA e EXECUTION: MODO NOTICIA para [TRADE], RISK CALC USD para [RISK] CALC USD, TRADE OPEN para [TRADE] OPEN e SYSTEM STATUS WRITE ERROR para [STATUS] WRITE ERROR. (5) [AI] LOAD passa de 30 min por instancia para 1x/h por CONTA e por simbolo (250 linhas no dia a repetir o mesmo caminho de ficheiro) e o [SCANNER] RESUMO deixa de chamar simbolos ao que sao VISITAS de simbolo por ciclo (194 visitas em 11 simbolos). Nenhum limite, regra de entrada ou de saida, lote, spread, alvo, precificacao ou parametro de risco foi alterado: muda apenas o que, e quantas vezes, vai para o journal. " + "v1.2.110 (03/11/2026) - P1.98: o bit MQL_TRADE_ALLOWED e POR GRAFICO e a unica prova de que estava a 1 era o snapshot de INIT do ULTIMO grafico que escreveu ProductionChecklist.txt, que nem sempre e o grafico em causa. O [STATUS] passa a publicar [PERM] com os cinco bits medidos AGORA nesta instancia (MQL_TRADE_ALLOWED, TERMINAL_TRADE_ALLOWED, ACCOUNT_TRADE_ALLOWED, ACCOUNT_TRADE_EXPERT, TERMINAL_CONNECTED), logo a permissao fica verificavel no journal grafico a grafico, sem depender de ficheiro comum. Nenhum limite, regra de entrada ou de saida, lote, spread, alvo, precificacao ou parametro de risco foi alterado: muda apenas o que a linha publica. " + "v1.2.109 (03/11/2026) - P1.97: quatro numeros do journal deixaram de poder ser lidos de duas maneiras. (1) [STATUS] Positions dizia 1 EA(magic) enquanto a aba Negociacao mostrava 0 no instante da auditoria: as duas leituras estavam certas em instantes diferentes (a posicao existia quando a linha saiu e fechou depois), por isso a linha passa a trazer ao lado PosTerminal, MargemUsada, MargemLivre e Equity, todos do mesmo instante, e a verificacao fica dentro da propria linha. (2) P/L passou a chamar-se P/Ldia(realizado) e FreeMargin passou a MargemLivre, porque o primeiro e o realizado do dia (balance menos o saldo do inicio do dia, 26,80) e nao o flutuante das posicoes abertas (0,00), e o segundo e AccountInfoDouble(ACCOUNT_MARGIN_FREE). (3) O [STATUS] passa a publicar [AI] SIMBOLO | idade | limite | estado | modelo: a idade da previsao so existia dentro do system_status.json do ULTIMO grafico que o escreveu, e por isso o JSON dizia age_seconds=30/stale=false enquanto Data/prediction_XAUUSD.json tinha 1860 s contra MaxPredictionAgeSec=900. (4) A linha Diagnostico: FALHAS DETECTADAS detalhava as 11 checagens e o journal mostrava apenas Broker: VERDE; passa a comecar pela contagem e a listar SOMENTE o que reprovou, com o detalhe de cada falha. Nenhum limite, regra de entrada ou de saida, lote, spread, alvo, precificacao ou parametro de risco foi alterado: (5) O [DIAG] FALHAS DETECTADAS era impresso por um else pendurado no if INTERNO de LogInicioDetalhe(), e nao no if(diagOK): saia exactamente quando todos os testes passavam, ao lado de [STATUS] HEALTHY. Passa a ter chavetas. Nenhum limite, regra de entrada ou de saida, lote, spread, alvo, precificacao ou parametro de risco foi alterado: muda apenas o que cada linha publica. " + "v1.2.93 (02/11/2026) - P1.80: restavam DUAS linhas SEM TAG no journal e as duas eram as do sinal. MEDIDO no Logs de 02/11 as 20:23 (MQL5, pasta Logs, 20261102.log): as unicas linhas fora do vocabulario [TAG] eram USDBRL SIGNAL BUY | RSI[1]=37.31, escritas por Core/SignalCore.mqh; houve 23 no dia e o mesmo par simbolo/RSI repetia-se nas 05:05, 05:31, 05:53, 05:56, 20:13 e 20:23, porque o RSI nao mudava. O defeito nao era so a tag: o throttle era um static UNICO partilhado por todos os simbolos, portanto o primeiro simbolo que escrevia no minuto gastava a vez e os outros ficavam invisiveis no journal - era impossivel saber quais simbolos tinham sinal no mesmo minuto. Duas correcoes, ambas de impressao: (1) as 6 mensagens de erro do sinal e as 2 mensagens de BUY/SELL passam a levar a tag [SIGNAL]; (2) o throttle passa a ser POR SIMBOLO (arrays estaticos indexados por simbolo, 60 s), como ja acontece em Core/MarketScanner.mqh. Efeito esperado: 0 linhas anonimas no journal de 03/11 e o sinal de cada simbolo visivel uma vez por minuto. Nenhum return, limite, regra de entrada ou de saida, lote, alvo, spread ou parametro de risco foi alterado. " + "v1.2.92 (02/11/2026) - P1.79: a melhoria anterior cortou as linhas SEM TAG, mas o journal continuava a repetir o mesmo facto porque ha 15 graficos e porque o texto se repete DENTRO do ciclo. MEDIDO no Logs de 02/11 as 20:16 (MQL5\\Logs\\20261102.log, 41 057 150 bytes, 185 920 linhas), janela de 4 000 linhas com a v1.2.91: 9,2 por cento sem tag (366 linhas, TODAS do DataLogger), [SCANNER] 116, [TRADE PIPELINE] 120, [LEARN] 243, [LOGGER OFFLINE] 82. Quatro correcoes, todas so de impressao: (1) o [SCANNER] SIGNAL OK passa a sair quando o sinal MUDA e no maximo 1x/30 min por simbolo, porque o mesmo USDBRL com Signal=1 imprimia de 6 em 6 segundos; (2) o [TRADE PIPELINE] INICIANDO passa de 1x/min por grafico para 1x/30 min por CONTA (era 15 x 1/min = 900 linhas/hora); (3) as 7 mensagens do DataLogger que ainda nao tinham tag passam a [DATA] e o DATA LOGGER SAVED passa a [DATA] SAVED com janela de 86400 s por CONTA e por simbolo - antes eram 11 simbolos x 15 graficos = 165 linhas por dia; (4) o retrato de ARRANQUE passa a ser escrito pelo PRIMEIRO grafico do reload e fica calado nos outros (Monitoring\\AccountLogGate.mqh, LogInicioDetalhe(), janela de 120 s por conta e cache por instancia): [VERSION] Modulos, [AI] Client, [REAL GUARD] demo, [BENCHMARK], [TELEMETRY], [ANTILOOP], [SYNC], [STATS], [QUALITY], [DATABASE], [VALIDATION] checklist, [SCHEDULER], [CHECKLIST] producao, [PATH] data, [LEARN] diario aplicado e [LEARN] resumo, e os instantaneos periodicos [DATABASE]/[SCHEDULER]/[TELEMETRY]/[BENCHMARK] passam a 1x/hora por conta. Se o ficheiro comum falhar, o portao devolve SEMPRE true: erro de log nunca esconde informacao. Nenhum limite, regra de entrada ou de saida, parametro de risco, lote, spread, alvo, precificacao ou return foi alterado. " + "v1.2.91 (02/11/2026) - P1.78: o journal ja nao tinha linha sem tag, mas ainda dizia a MESMA coisa 16 vezes porque ha 16 graficos. MEDIDO no Logs de 02/11 as 19:54, janela de 1 280 linhas com a v1.2.90: [VERSION] 86, [INIT] 80, [LEARN] 80, [AI] 74, [NOTIFY] 59, [CONFIG] 59 - o mesmo facto escrito uma vez por instancia, mais [VALIDATION] 48, [BACKUP] 35, [DIAG] 33 e 32 de [RECOVERY], [REAL GUARD], [LOGGER OFFLINE], [CHECKLIST], [SCHEDULER], [BROKER] e [PATH]. O mecanismo certo ja existia desde o P1.73 (Monitoring\\AccountLogGate.mqh, janela por CONTA em Files\\Common\\XAU_AI_PRO\\loggate_<tag>.bin) e passa a cobrir o arranque: [INIT] system, [INIT] symbol manager, [INIT] execution engine e [INIT] all modules passam a 1 linha por conta por hora; [VERSION] e [VERSION] Modulos saem 1x por conta por hora, com a tag a incluir a versao (version_1.2.91) para que uma versao NOVA apareca sempre; [NOTIFY] sai 1x por conta e nao duas vezes por instancia, porque o OnInit do EA e o LogStatus do NotificationCenter passam a partilhar a mesma tag; [CONFIG] inicializado, [CONFIG] perfil ativo (tag com o NOME do perfil, logo um perfil novo imprime na hora) e [CONFIG] estado passam a 1x por conta por hora. O include do portao sobe para o topo do EA para que qualquer modulo possa chamar AccountLogGatePodeImprimir sem repetir o #include. As 7 linhas de falha de modulo que ainda nao tinham tag (ATR OFF, ADX OFF, RSI OFF, TrendFilter OFF, MTF OFF, DataLogger OFF, TradeLogger OFF) passam a [INIT] e a linha do SymbolManager passa a [SYMS], para que o journal nao volte a ter linha anonima. Se o ficheiro comum falhar, o portao devolve SEMPRE true: erro de log nunca esconde informacao. Nenhum limite, regra de entrada ou de saida, parametro de risco, lote, spread, alvo, precificacao ou return foi alterado: muda apenas quantas vezes a mesma linha vai para o journal. v1.2.90 (02/11/2026) - P1.77: as ultimas 32 linhas sem tag eram todas do mesmo modulo. MEDIDO no Logs de 02/11 as 19:52, janela de 1 292 linhas (94 sem tag antes do P1.76, 357 antes do P1.75): 32 linhas sem tag, 2,5 por cento, e TODAS do AIConnector - 'AI LOAD', 'AI FILE NOT FOUND', 'AI INVALID JSON SYMBOL', 'AI GATEWAY', 'AI PYTHON', 'AI BLOCK'. O modulo escrevia no journal com nomes proprios, fora do vocabulario [TAG] que o resto do EA usa, e por isso nao se filtrava por tag nenhuma. As 11 mensagens passam a levar o prefixo [AI] e o journal deixa de ter linha sem tag: qualquer linha do journal pertence agora a um namespace. Duas mensagens foram renomeadas para portugues ('FILE NOT FOUND' -> 'FILE EM FALTA', 'JSON EMPTY' -> 'JSON VAZIO') para ficarem coerentes com o resto do journal. Nenhuma decisao de sinal muda: os 11 pontos sao Print de diagnostico, ja limitados a 1 vez por 30 minutos por instancia desde a v1.2.33. v1.2.89 (02/11/2026) - P1.76: ultimas linhas sem tag e a causa repetida. MEDIDO no Logs de 02/11 as 19:47, janela de 1 200 linhas (1 534 antes): 7,8 por cento sem tag contra 23,3 por cento, com o resto a ser o ENCERRAMENTO da v1.2.87. Ficaram duas linhas sem tag por instancia - 'Inicializando modulos...' (sem dados, o [INIT] all modules OK ja o diz) e o aviso do SymbolManager - e as duas passam a comentario e a [SYMS]. A causa de TG_MQL_OFF no diagnostico tem ~900 caracteres e saia 16x por arranque; passa a 'codigo=N | causa completa em [TRADE BLOCK]', porque o codigo identifica o bit e o texto completo continua no [TRADE BLOCK] uma vez por conta. v1.2.88 (02/11/2026) - P1.75: o journal ainda gastava 21 linhas sem tag por instancia, e 12 delas eram o ENCERRAMENTO. MEDIDO no Logs de 02/11 na janela 19:34:24-19:40:04 (1 534 linhas, 357 sem tag = 23,3 por cento): 32 separadores '====', 16 'XAU_AI_PRO FINALIZANDO', 16 'Reason=N', 16 'XAU_AI_PRO FINALIZADO', 16 'SYSTEM CLOSED', 16 'DATA LOGGER OFFLINE' e 16 blocos BACKTEST ANALYZER com Trades=0/PF=0.00, mais 9 linhas de arranque sem tag por grafico ('XAU_AI_PRO INITIALIZING', 'SYSTEM READY', 'Inicializando modulos...', 'MTF INIT', 'DATA LOGGER MULTI-SYMBOL ONLINE', 'TradeLogger inicializado', 'BACKTEST ANALYZER | Inicializado', 'AI GATEWAY | WebRequest falhou'). Correcao so de impressao: (1) o OnDeinit passa a escrever UMA linha [STOP] com simbolo, motivo e equity em vez de 5 (2 separadores, FINALIZANDO, Reason= e FINALIZADO) e o 'SYSTEM CLOSED' do ShutdownSystem deixa de sair, porque o [STOP] ja o diz com dados; (2) 'XAU_AI_PRO INITIALIZING' e 'SYSTEM READY' desaparecem (o [START] e o [INIT] system + signalcore OK ja os substituem com valores) e a falha de compatibilidade passa a '[SYSTEM] FAIL'; (3) as restantes 7 passam a ter tag: [DATA] logger multi-simbolo online, [DATA] logger offline, [TRADELOG] inicializado, [BT] inicializado, [BT] resumo e [MTF] INIT, e o erro do gateway passa a '[AI] GATEWAY falhou'; (4) o resumo de backtest deixa de sair quando nao houve nenhum trade, porque era uma linha de zeros por instancia. Nenhum limite, regra de entrada ou de saida, parametro de risco, lote, spread, alvo, precificacao ou return foi alterado: muda apenas o texto e a quantidade de linhas que o EA escreve. v1.2.87 (02/11/2026) - P1.74: o journal deixou de contar o arranque 16 vezes. MEDIDO no journal de 02/11 (MQL5\\Logs\\20261102.log, 171 952 linhas, 37 439 482 bytes): 95 508 linhas (55,5 por cento) nao tinham tag nenhuma, e o arranque de UMA instancia custava 227 linhas - cerca de 3 600 num reload dos 16 graficos. Desse total, 107 eram dump decorativo e repetido: 57 do SymbolManager (Market Watch, lista de ativos, um Active symbol registered por simbolo), 20 do BrokerAnalyzer, 5 do BrokerInfo, 5 do EnvironmentManager, 5 do PathManager, 5 do BrokerConfig, 9 do cabecalho do OnInit, 11 do resumo de memoria aprendida e 20 separadores ==== e ---- sem informacao. Tudo isso passa a 10 linhas com tag: [START] conta/corretora/servidor/simbolo/saldo/equity, [SYMS] configurados/ativos/marketwatch/grafico/lista, [BROKER] dump do simbolo, [BROKER] conta, [ENV], [PATH] x2, [BROKERCFG], [LEARN] resumo e [INIT] pronto. Nenhum limite, regra de entrada ou de saida, parametro de risco, lote, spread, alvo, precificacao ou return foi alterado: muda apenas o texto e a quantidade de linhas que o EA escreve. " + "v1.2.86 (02/11/2026) - P1.73: MEDIDO no journal de 02/11 (167 665 linhas; 7 596 de [TRADE BLOCK], 5 848 de [LEARN], 3 745 de [SESSION], 2 285 de [VERSION], 1 095 de [HEALTH], 961 de [LOGGER OFFLINE]). O P1.72 cortou a repeticao DENTRO de cada grafico (TRADE BLOCK 68,1/h -> 1/h por instancia), mas o journal continuou a repetir texto IDENTICO porque ha 16 graficos: 16 x 1/hora = 16 linhas/hora por tag. Este ciclo corrige isso na raiz: o throttle deixa de ser por instancia e passa a ser por CONTA, num ficheiro comum (Monitoring\\AccountLogGate.mqh, Files\\Common\\XAU_AI_PRO\\loggate_*.bin). Sao tres pontos, todos so de impressao: (1) [TRADE BLOCK] com a MESMA causa passa a 1 linha/hora por conta (era 1/hora por grafico) e a causa NOVA passa a 1 linha/2 min por conta, porque o reload dos 16 graficos escrevia a mesma causa 16 vezes; (2) [SESSION] estado salvo passa a no maximo 1 linha/10 min por conta, no rollover de 03/11 sairam 12 linhas iguais em 40 segundos; (3) o resumo de hora do [HEALTH] passa a 1 linha/hora por conta, mas MUDANCA de estado continua a sair na hora, sem filtro. Se o ficheiro comum falhar (bloqueado, disco, permissao), o modulo devolve SEMPRE true: erro de log nunca esconde informacao. Nenhum limite, regra de entrada ou de saida, parametro de risco, lote, spread, alvo ou precificacao foi tocado. v1.2.85 (02/11/2026) - P1.72: MEDIDO na janela 17:40-18:44 do Logs de 02/11 (872 linhas, a janela silenciosa depois do reload): o journal ainda repetia retratos e o mesmo bloqueio. Os maiores emissores dessa janela eram [TRADE BLOCK] com 117 linhas da MESMA causa, [SESSION] estado salvo 64, [CIRCUIT] BROKER OK e BROKER INSTAVEL 64 (32 de cada, sempre em par) e [LEARN] varredura em espera 33. Correcao minima, so de impressao: (1) AllowBlockPrintCausa passa de 1x/10 min para 1x/hora por causa - a causa ja sai escrita por inteiro e o bit por programa nao se cura sozinho, logo 16 instancias x 6 por hora davam 117 linhas por hora a dizer o mesmo; (2) [SESSION] estado salvo passa de 30 min para 60 min de heartbeat, continuando a sair na hora quando o resumo muda; (3) a linha [CIRCUIT] BROKER OK so sai quando a rajada transitoria tem 3 ou mais leituras ou 60 ou mais segundos - uma leitura isolada continua a ser contada, continua a nao bloquear nada e deixa de escrever duas linhas para dizer que nada aconteceu; (4) [LEARN] varredura em espera passa de 1h para 4h por instancia e [BACKUP] STANDBY de 1h para 4h; (5) o aviso SYSTEM STATUS WRITE ERROR passa a sair 1x por sessao com o codigo, porque a falha 5004 e o ficheiro de estado comum ocupado por outra instancia e o retrato e reescrito no ciclo seguinte; (6) o erro duro do AI GATEWAY (4014/4060/5200/5202, configuracao do terminal que nao se cura sozinha) passa de 30 min para 4h. Nenhum limite, regra de entrada ou de saida, parametro de risco, lote, spread ou precificacao foi tocado: muda apenas o que vai para o journal. " "v1.2.84 (02/11/2026) - P1.71: o journal do dia 02/11 ainda tinha duas fontes de repeticao que nao dependem de nenhum evento de mercado. (1) NOTIFY: o push do terminal esta DESLIGADO (TerminalInfoInteger(TERMINAL_NOTIFICATIONS_ENABLED)=0) e o EA chamava SendNotification na mesma, falhando sempre com o erro 4517 - 1 626 linhas no dia, 80 delas numa janela de 3 minutos de reload. O estado do push passa a ser lido antes da chamada: desligado, sai UMA linha por sessao e a funcao devolve false sem round-trip, o mesmo valor de antes, logo nenhum chamador muda de comportamento. (2) DATA LOGGER OFFLINE: saia em TODO o OnDeinit mesmo quando o logger nunca abriu ficheiro nenhum, 316 linhas no dia so com reloads; passa a sair apenas quando havia mesmo um ficheiro aberto. Nenhum limite, regra de entrada ou de saida, parametro de risco, lote, spread ou precificacao foi tocado: muda apenas o que vai para o journal. " "v1.2.83 (02/11/2026) - P1.70: o journal ainda tinha 3 181 linhas de [SESSION] estado salvo, 948 de BACKTEST ANALYZER, 625 de BENCHMARK e 316 de QUANT MATRIX no dia 02/11. Eram 16 instancias a repetir a MESMA tabela a cada encerramento e o MESMO estado a cada 5 minutos, sem evento nenhum. Correcao minima, so de impressao: (1) o retrato QUANT MATRIX e o relatorio de BENCHMARK voltam a sair apenas no tester, porque os ficheiros QuantReport.txt e BenchmarkReport.txt continuam a ser gravados em FILE_COMMON; (2) a linha BACKTEST ANALYZER Finalizado tambem fica so no tester; (3) a linha [SESSION] estado salvo passa a sair apenas quando o resumo MUDA, com heartbeat de 30 min. Nenhum limite, regra de entrada, saida ou parametro de risco foi alterado. " "v1.2.82 (02/11/2026) - P1.69: o journal novo do P1.68 mostrou, na MESMA linha, \"[HEALTH] WARNING\" e \"Status: HEALTHY\". MEDIDO em 02/11 as 15:54 nos quatro graficos sem tick (USDBRL/M5, USDCOP/H1, USDCLP/H1, USDRUB/H1): ATR, ADX, RSI e IA contam 1 a 3 falhas porque so avancam dentro de OnTick, e HealthGetState() transformava essas falhas em TM_WARNING mesmo quando o P1.67 ja tinha decidido que sem tick nao ha falha. Duas correcoes pequenas: (1) as falhas dos watchdogs so contam para o veredicto quando houve tick nos ultimos 15 s (o mesmo limiar do HealthMonitorCheckTickTimeout), continuando a ser somadas e impressas; (2) a linha Status do resumo passa a ler HealthGetStateString(), a mesma fonte do tag, e acrescenta o resultado do ultimo check entre parenteses - logo tag e linha nunca mais podem discordar. Nenhum limite, return, regra de trading ou parametro de risco foi tocado: muda a atribuicao de um veredicto de saude e a linha que o publica. " "v1.2.81 (02/11/2026) - P1.68: o journal tinha os numeros todos e nenhuma leitura. MEDIDO em 02/11/2026 no Logs de producao (138 702 linhas, 15,5 MB): [SCANNER] BLOCK 18 532 linhas (13,4 por cento), SYMBOL MANAGER 7 955 (5,7), [TRADE BLOCK] 7 272 (5,2), 586 blocos SYSTEM STATUS e 152 blocos HEALTH MONITOR que somam cerca de 11 000 linhas de retrato, e [SESSION] estado salvo 3 070. Nenhuma dessas linhas era um evento: era o mesmo retrato periodico repetido por 16 instancias. Correcao minima, so de impressao: (1) o retrato SYSTEM STATUS e o retrato HEALTH MONITOR passam a sair numa UNICA linha, com todos os valores que ja saiam, colapsados por JournalOneLine; (2) o gate do [TRADE BLOCK] passa a ser por CAUSA, causa nova imprime na hora e causa igual sai 1x/10 min em vez de 1x/60 s (AllowBlockPrintCausa, em TimeLocal); (3) o detalhe [SCANNER] BLOCK por simbolo passa a sair so quando o DESFECHO daquele simbolo muda, com heartbeat de 30 min, porque o [SCANNER] RESUMO ja publica a contagem por balde a cada minuto; (4) a linha SYMBOL MANAGER Resolved deixa de ser impressa quando o nome resolvido e IGUAL ao pedido (7 955 linhas a dizer XAUUSD para XAUUSD). Nenhum limite, return, regra de entrada ou de saida, parametro de risco, lote, spread ou precificacao foi tocado: muda apenas o que vai para o journal. " "v1.2.80 (02/11/2026) - P1.67: o MESMO estado de tick produzia dois veredictos e o watchdog ficava cego. MEDIDO em 02/11/2026 no journal das 16 instancias, com v1.2.79: USDBRL/M5, USDCOP/H1 e USDCLP/H1 imprimiam Total ticks: 0 e Segundos sem tick: 14641 e, na mesma janela, ora Status: HEALTHY (Segundos sem tick: 120, Backoff: nivel=0 intervalo_efetivo=60s), ora Status: FAILURE (Segundos sem tick: 14641, Backoff: nivel=11 intervalo_efetivo=1920s). Causa medida: HealthMonitorCheckTickTimeout(15) perdoa o sem tick quando HealthSymbolSessionOpen() e false (v1.2.31), mas HealthMonitorCheckHeartbeats() nao tinha essa guarda; ATR/ADX/RSI/IA so avancam dentro de OnTick, logo sem tick falham sempre, healthy vai a false e g_healthConsecutiveFails sobe a 11 (1920s = watchdog cego 32 min). Correcao minima: o resultado do teste de tick fica guardado em tickEmFalta e a falha dos heartbeats so propaga a healthy quando HOUVE tick. Nenhum limite, return, regra de trading, parametro de risco, condicao de entrada ou de saida foi alterado: so a atribuicao de um veredicto de saude. " "v1.2.79 (02/11/2026) - P1.65: corrigida a mensagem do [TRADE BLOCK] quando o bit em falta e o do PROGRAMA. A frase anterior mandava o operador para as propriedades do EA; medido as 09:00, experts_trade_allowed=true e TERMINAL_TRADE_ALLOWED=1, logo o botao do terminal estava LIGADO e so falta o bit por programa. A frase passa a dizer o que foi medido, a listar as hipoteses por testar e a manter a lista do que ja foi rejeitado por medicao. " "v1.2.78 (02/11/2026) - P1.64: MEDIDO no codigo - CTradeGate::Evaluate() lia os quatro bits de permissao e nunca TERMINAL_CONNECTED, por isso um terminal sem ligacao devolvia TG_OK (trading permitido) enquanto as duas checklists escreviam terminal desconectado. Passa a existir TG_DISCONNECTED=5, testado ANTES dos outros quatro, e os tres sitios que liam o bit cru (Diagnostics, ProductionChecklist item 0, ValidationChecklist item 8) passam a ler Core/TradeGate.mqh e a escrever a MESMA frase. " "v1.2.77 (02/11/2026) - P1.63: o bloco PERMISSOES do diagnostico lia 1 dos 5 bits e chamava-lhe VERDE. MEDIDO as 08:34: o heartbeat gravava terminal_trade_allowed=true e trade_gate_code=3 (TG_MQL_OFF) no mesmo instante, enquanto as 16 charts imprimiam MQL_TRADE_ALLOWED=0. Passa a ler Core/TradeGate.mqh e a publicar a causa. " "v1.2.76 (02/11/2026) - P1.62: o heartbeat, o ExternalBridge e o SystemStatus passam a publicar o veredito do portao (Core/TradeGate.mqh) em vez de bits crus, e o ConnectionGuard deixa de testar 2 dos 5 bits. MEDIDO as 08:17: o heartbeat dizia autotrading=true e o bridge autotrading=on enquanto as 16 charts imprimiam MQL_TRADE_ALLOWED=0. " "v1.2.75 (02/11/2026) - P1.61: portao de negociacao, item Permissions da producao e item Trade Manager da validacao passam a ler a MESMA fonte (Core/TradeGate.mqh), e a mensagem nomeia qual das tres permissoes falta."
