# Credenciais locais da MEXC - nunca commit este arquivo preenchido.
# Crie uma cópia chamada .env.mexc.local e substitua os valores vazios.
# Use permissões de leitura e negociação; mantenha saque/withdraw desativado.
MEXC_SPOT_API_KEY=
MEXC_SPOT_API_SECRET=
MEXC_FUTURES_API_KEY=
MEXC_FUTURES_API_SECRET=

# Opcional: endpoints oficiais, sem chaves no frontend.
MEXC_SPOT_BASE_URL=https://api.mexc.com
MEXC_FUTURES_BASE_URL=https://contract.mexc.com
