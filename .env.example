# ============================================
# XAU AI PRO - CONFIGURACAO
# ============================================

# Environment
ENVIRONMENT=production

# ===========================================================================
# ATENCAO — ESTE ARQUIVO NAO LIGA NADA (verificado em 03/10/2026)
# ===========================================================================
# `frontend/src-tauri/src/main.rs` le as flags de execucao com `std::env::var`
# e o `Cargo.toml` NAO tem a crate `dotenv`. Ou seja: o app desktop **nao le
# este arquivo**. O que ele le sao variaveis de ambiente do Windows, ou o que o
# launcher `scripts\app_producao.bat` exportar antes de subir o app.
#
# Consequencia pratica: trocar `ENVIRONMENT=production` aqui nao muda o
# comportamento do app. E a troca de `ASSET`/`TRADING_PAIR` deste bloco tambem
# nao muda a operacao — nenhuma delas e lida pelo caminho de execucao.
#
# O que REALMENTE controla o envio de ordem, medido no fonte:
#
#   `backend/mt5_gateway.py` — trava em 4 rotas (linhas 1825, 2044, 2155, 2200):
#       XAU_ENABLE_TRADE_COMMANDS=1  OU  XAU_ENABLE_DEMO_ORDERS=1
#       E payload com confirm=true
#   `frontend/src-tauri/src/main.rs:636` — repassa XAU_ENABLE_REAL_ORDERS ao
#       bridge, e na linha 644 USA A VARIAVEL SO PARA ESCREVER UM LOG.
#
# `XAU_ENABLE_REAL_ORDERS` **nao habilita nem bloqueia ordem nenhuma**. Ligar
# produz a linha "ATENCAO: ordens reais habilitadas" sem que nada mude — e isso
# e pior do que nao ligar, porque o log passa a mentir.
#
# `backend/mt5_gateway.py:_conta_kind()` diz no proprio docstring: "Apenas
# informativo. Nada aqui bloqueia envio de ordem".
#
# Para as flags que o app realmente le, veja `scripts\app_producao.bat`.
# ===========================================================================

# Sentry Configuration (obtenha seu DSN em https://sentry.io)
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=

# Trading Configuration
ASSET=XAUUSD
TRADING_PAIR=XAU/USD
TIMEFRAME=M5

# API Keys (nunca commite no git!)
BROKER_API_KEY=your_broker_api_key_here
BROKER_API_SECRET=your_broker_api_secret_here

# Database
DATABASE_PATH=./database/trading.db

# Logging
LOG_LEVEL=INFO
LOG_FILE=./Logs/xau_ai_pro.log

# Model Configuration
MODEL_PATH=./Python/ai/
RETRAIN_INTERVAL=24h

# Risk Management
MAX_POSITION_SIZE=0.1
STOP_LOSS_PERCENT=2.0
TAKE_PROFIT_PERCENT=5.0

# Slack Notifications (Incoming Webhook)
# Crie em: https://api.slack.com/apps -> Incoming Webhooks -> Add New Webhook
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T00000000/B00000000/XXXXXXXXX
SLACK_ENABLED=true
SLACK_NOTIFY_TRADES=true
SLACK_NOTIFY_ERRORS=true
SLACK_NOTIFY_RISK=true

# Kilo Sessions (inbound webhook - captura eventos/sessoes)
# URL fornecida pelo painel do Kilo (dominio hooks.kilosessions.ai)
KILO_WEBHOOK_URL=
