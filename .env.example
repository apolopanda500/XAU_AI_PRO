# ============================================
# XAU AI PRO - CONFIGURACAO
# ============================================

# Environment
ENVIRONMENT=production

# Sentry Configuration (obtenha seu DSN em https://sentry.io)
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=

# Trading Configuration
ASSET=XAUUSD
TRADING_PAIR=XAU/USD
TIMEFRAME=M5

# API Keys (nunca commite no git!)
BROKER_API_KEY=your_broker_api_key_here
BROKER_API_SECRET=your_broker_api_secret_here

# Database
DATABASE_PATH=./database/trading.db

# Logging
LOG_LEVEL=INFO
LOG_FILE=./Logs/xau_ai_pro.log

# Model Configuration
MODEL_PATH=./Python/ai/
RETRAIN_INTERVAL=24h

# Risk Management
MAX_POSITION_SIZE=0.1
STOP_LOSS_PERCENT=2.0
TAKE_PROFIT_PERCENT=5.0

# Slack Notifications (Incoming Webhook)
# Crie em: https://api.slack.com/apps -> Incoming Webhooks -> Add New Webhook
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T00000000/B00000000/XXXXXXXXX
SLACK_ENABLED=true
SLACK_NOTIFY_TRADES=true
SLACK_NOTIFY_ERRORS=true
SLACK_NOTIFY_RISK=true
