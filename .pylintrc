# ConfiguraÃ§Ã£o do Pylint â€” XAU AI PRO
# Score mÃ­nimo aceito e checks desativados com justificativa.

[MASTER]
# Evita varrer ambientes virtuais
ignore=.venv
persistent=no

[MESSAGES CONTROL]
# C0114/C0115/C0116 â€” docstrings ausentes (cÃ³digo legado extenso)
# R0801 â€” duplicate-code (padrÃµes repetidos entre mÃ³dulos MT5/tk; refatoraÃ§Ã£o futura)
# E0401/E0611/E1101/E1120 â€” import-error/no-member: falsos positivos com mÃ³dulos
#   nativos nÃ£o instalados no CI (MetaTrader5/mt5, tkinter, sentry_sdk.integrations)
# W0703/W0718 â€” broad-except: capturas amplas intencionais (robÃ´ nÃ£o pode parar)
# R0903/R0902/R0913/R0914/R0915 â€” limites estruturais (too-few-public-methods etc.)
# C0103 â€” invalid-name (convenÃ§Ãµes mistas tk/MT5)
# C0301 â€” line-too-long (formatado pelo editor)
# W0511 â€” fixme (TODOs documentados)
# W1514 â€” unspecified-encoding (resolvido globalmente no launcher)
# W0603 â€” global-statement (estado do robÃ´)
# C0413 â€” wrong-import-position (imports condicionais intencionais no pipeline)
# Checks cosmÃ©ticos/estilo legado (refatoraÃ§Ã£o gradual futura)
disable=
    missing-module-docstring,
    missing-class-docstring,
    missing-function-docstring,
    duplicate-code,
    import-error,
    no-member,
    no-name-in-module,
    not-callable,
    unused-import,
    unused-variable,
    unused-argument,
    redefined-outer-name,
    attribute-defined-outside-init,
    broad-exception-caught,
    broad-exception-raised,
    bare-except,
    invalid-name,
    line-too-long,
    fixme,
    unspecified-encoding,
    global-statement,
    wrong-import-position,
    wrong-import-order,
    ungrouped-imports,
    multiple-imports,
    multiple-statements,
    import-outside-toplevel,
    no-else-raise,
    no-else-return,
    raise-missing-from,
    unnecessary-lambda,
    unnecessary-lambda-assignment,
    implicit-str-concat,
    bad-indentation,
    disallowed-name,
    mixed-line-endings,
    trailing-whitespace,
    trailing-newlines,
    missing-final-newline,
    consider-using-f-string,
    subprocess-run-check,
    too-few-public-methods,
    too-many-ancestors,
    too-many-instance-attributes,
    too-many-arguments,
    too-many-locals,
    too-many-branches,
    too-many-statements,
    too-many-public-methods,
    too-many-positional-arguments,
    too-many-return-statements,
    too-many-lines,
    reimported,
    protected-access,
    consider-using-with,
    consider-using-sys-exit,
    superfluous-parens,
    chained-comparison,
    using-constant-test,
    used-before-assignment,
    undefined-variable,
    function-redefined,
    try-except-raise,
    super-with-arguments,
    pointless-statement,
    expression-not-assigned,
    access-member-before-definition,
    f-string-without-interpolation,
    unsubscriptable-object,
    comparison-with-callable,
    simplifiable-condition,

    unnecessary-pass,
    unnecessary-ellipsis,
    anomalous-backslash-in-string,
    singleton-comparison,
    self-assigning-variable,

    literal-comparison,
    unidiomatic-typecheck,
    deprecated-module,
    deprecated-method,
    abstract-method,
    arguments-differ,
    signature-differs,
    keyword-arg-before-vararg,
    non-parent-init-called,

    method-hidden,
    attribute-defined-outside-init

[BASIC]
# Aceita nomes curtos comuns em mÃ³dulos numÃ©ricos
good-names=i,j,k,ex,Run,_,q,s,p,f,df

[FORMAT]
max-line-length=120

[DESIGN]
max-args=10
max-attributes=12
max-locals=20
max-branches=15
max-public-methods=25

[SIMILARITIES]
min-similarity-lines=8

[REPORTS]
score=yes

[TYPECHECK]
# MÃ³dulos nativos sem stubs no CI
ignored-modules=mt5,MetaTrader5,tkinter,tkinter.ttk,tkinter.filedialog,tkinter.messagebox
