; XAU_AI_PRO v1.2.0 - PRESET AUTOTRADE ON (AutoTrade=true)
; Idem XAU_AI_PRO.PRO.set, com AutoTrade habilitado para operacao em demo.
; Uso: F7 no chart > aba Inputs > Load
AutoTrade=true
MagicNumber=2026001
TradeComment=XAU_AI_PRO

UseRiskManagement=true
LotSize=0.01
RiskPercent=1.0
MaxDailyLossPercent=5.0
MaxDrawdownPercent=15.0
MinEquityPercent=10.0
MinFreeMargin=20.0
MaxTradesPerDay=20
MaxOpenPositions=5
AllowMinLotOverride=true

MaxSpread=50
MaxSpreadBySymbol=GOLD#:350,BTCUSD#:600,ETHUSD#:600
Slippage=5
RetryMaxAttempts=5
RetryBaseDelayMs=100
RetryDelayMultiplier=2.0
RetryMaxDelayMs=2000
RetryMaxSlippage=50
RetrySlippageIncrement=2

StopLossPoints=300
TakeProfitPoints=600

EnableBreakEven=true
BreakEvenTrigger=80
BreakEvenOffset=10
EnableTrailingATR=true
ATRMultiplier=1.2
EnablePartialClose=true
PartialTrigger=150
PartialPercent=30.0

EnableSpreadFilter=true
EnableSessionFilter=false
EnableTrendFilter=true
EnableVolatilityFilter=false
EnableADXFilter=true
EnableMTFConfirmation=false
EnableNewsFilter=false
EnableAIFilter=true
NewsCurrencies=
NewsImpactThreshold=2
NewsMinutesBefore=30
NewsMinutesAfter=30

MinAIConfidence=50.0
RequireAIJSON=false
KCI_VD_Period=14
KCI_DX_BasePeriod=9
KCI_DX_ZScorePeriod=30
KCI_DX_Sensitivity=1.5
KCI_DX_MainThreshold=30.0

TradeStartHour=0
TradeEndHour=24

FastEMA=50
SlowEMA=200
RSIPeriod=14
RSIPullbackBuy=45.0
RSIPullbackSell=55.0
ATRPeriod=14
ADXPeriod=14
MinimumADX=18.0

EnableScheduler=true
SchedulerIntervalSec=60
EnableWeekendShutdown=true
EnableDatabase=false
DatabasePath=XAU_AI_PRO.db
EnableTelemetry=true
EnableDataset=true
SaveDatasetCSV=true
EnableBacktestLog=true
EnableDashboard=true
EnableLogs=true
DebugTradeDecision=true

EnableHealthMonitor=true
HealthCheckInterval=60
HealthWatchdogInterval=120
EnableAuditLog=true
EnableDiagnostics=true

EnableMultiSymbol=true
Symbols=XAUUSD,EURUSD,GBPUSD,USDJPY,AUDUSD,USDCAD,NZDUSD,USDCHF,XAGUSD,US30,US500,USTEC

EnableVerboseDebug=true